@* Navigasjonsmeny for AdminLayout *@
@inject IWebHostEnvironment Env


<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.ArrowBack" ActiveClass="">
        Tilbake til CompVault
    </MudNavLink>

    <MudDivider />

    <MudNavGroup Title="Brukere og tilgang" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
        <MudNavLink Href="@PageRoutes.Users.List" Icon="@Icons.Material.Filled.People">
            Brukere
        </MudNavLink>
        <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.Shield">
            Roller
        </MudNavLink>
        <MudNavLink Href="/admin/departments" Icon="@Icons.Material.Filled.Business">
            Avdelinger
        </MudNavLink>
    </MudNavGroup>

    @if (Env.IsDevelopment())
    {
        <MudDivider />
        <MudNavLink Href="@PageRoutes.Dev.Panel" Icon="@Icons.Material.Filled.Code">
            Dev Panel
        </MudNavLink>
    }
</MudNavMenu>