@inherits LayoutComponentBase
@inject IThemeService ThemeService

@* Layout for alle sider til CompVault som ikke er admin *@

<!-- =========================
     THEME SYSTEM
     Setter aktivt tema og styrer mørk/lys-modus for hele appen.
     Bruker MudBlazor ThemeProvider + egen ThemeService for persistens
========================= -->
<MudThemeProvider @ref="_mudThemeProvider"
                  Theme="_theme"
                  @bind-IsDarkMode="_isDarkMode" />

<!-- Popovers: Dropdowns, tooltips, menus -->
<MudPopoverProvider />

<!-- Dialog system: modaler og dialogs -->
<MudDialogProvider />

<!-- Snackbar system: toast notifications -->
<MudSnackbarProvider />

<!-- =========================
     APP LAYOUT (GLOBAL STRUCTURE)
     Wrapper hele applikasjonen
========================= -->
<MudLayout>

    <AuthorizeView>

        <Authorized>

            <!-- =========================
                 TOP BAR (APPBAR)
                 - Menu button for sidebar
                 - Theme toggle (dark/light)
                 - Global actions kan legges her senere (search, notifications, user menu)
            ========================== -->
            <AppBar ShowMenuButton="true"
                    OnMenuButtonClick="ToggleDrawer"
                    @bind-IsDarkMode="_isDarkMode" />

            <!-- =========================
                 SIDE NAVIGATION (DRAWER)
                 - Navigasjon for hele appen
                 - Komponentbasert (AppNavMenu)
                 - Kan gjøres collapsible / mini mode senere
            ========================== -->
            <AppDrawer @bind-IsOpen="_drawerOpen">
                <AppNavMenu />
            </AppDrawer>

            <!-- =========================
                 MAIN CONTENT AREA
                 - @Body = alle sider rendres her
                 - Padding flyttet hit for moderne SaaS layout
                 - Full kontroll over spacing per app i stedet for global container
            ========================== -->
            <MudMainContent Class="main-content">

                @Body

            </MudMainContent>

        </Authorized>

        <!-- =========================
             AUTH GUARD
             Hvis bruker ikke er logget inn → redirect til login
        ========================== -->
        <NotAuthorized>
            <RedirectTo Href="@PageRoutes.Auth.LoginEmail" />
        </NotAuthorized>

    </AuthorizeView>

</MudLayout>

<!-- =========================
     CODE BEHIND (STATE + LOGIC)
========================= -->
@code {

    // ========================
    // UI STATE
    // ========================

    // Drawer state (sidebar open/close)
    private bool _drawerOpen = false;

    // Dark mode state (bindes til MudThemeProvider)
    private bool _isDarkMode;

    // Reference til MudBlazor theme system
    private MudThemeProvider _mudThemeProvider = null!;

    // Aktivt theme (custom CompVault theme)
    private readonly MudTheme _theme = CompVaultMainTheme.Theme;

    // ========================
    // LIFECYCLE
    // ========================

    /// <summary>
    /// Kjøres første gang komponenten rendres.
    /// Henter lagret theme preference fra ThemeService
    /// og setter dark/light mode basert på brukerinnstilling eller system.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Hent initial dark mode (persistert eller system default)
            _isDarkMode = await ThemeService.GetInitialDarkModeAsync(_mudThemeProvider);

            // Oppdater UI etter async load
            StateHasChanged();
        }
    }

    // ========================
    // ACTIONS / EVENTS
    // ========================

    /// <summary>
    /// Toggle sidebar (drawer open/close)
    /// Brukes av AppBar menu button
    /// </summary>
    private void ToggleDrawer()
        => _drawerOpen = !_drawerOpen;

}