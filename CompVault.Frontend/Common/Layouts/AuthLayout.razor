@inherits LayoutComponentBase
@inject IThemeService ThemeService

<MudThemeProvider @ref="_mudThemeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AppBar ShowMenuButton="false">
        <RightContent>
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode"/>
        </RightContent>
    </AppBar>
    
    <MudMainContent Class="@(_isDarkMode ? "cv-login-dark" : "cv-login-light")">
        <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>

@code {
    
    // ======================== Private felt ========================
    private bool _isDarkMode;
    
    // Referansen til ThemeProvider komponenten for å endre tema
    private MudThemeProvider _mudThemeProvider = null!;
    
    private readonly MudTheme _theme = CompVaultMainTheme.Theme;
    
    // ======================== Lifecycle ========================
    
    /// <summary>
    /// Ved første render så henter vi lokalt lagret tema, eller så bruker vi nettleserens modus
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await ThemeService.GetInitialDarkModeAsync(_mudThemeProvider);
            StateHasChanged();
        }
    }
    
    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await ThemeService.SaveDarkModeAsync(_isDarkMode);
    }
}