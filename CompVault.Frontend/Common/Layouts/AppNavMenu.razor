@* Standard navigasjonsmeny for MainLayout *@
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudNavMenu Class="cv-nav-menu">
    <MudText Typo="Typo.overline" Class="cv-nav-section-title px-4 mt-4 mb-2">
        Min side
    </MudText>

    <MudNavLink Href="/dashboard"
                 Match="NavLinkMatch.All"
                 Icon="@Icons.Material.Filled.Dashboard"
                 Class="cv-nav-link">
        Dashboard
    </MudNavLink>

    <AuthorizeView Policy="@Permissions.CompetenciesRead">
        <Authorized>
            <MudNavLink Href="@PageRoutes.UserCompetencies.List"
                        Icon="@Icons.Material.Filled.WorkspacePremium"
                        Class="cv-nav-link">
                Min kompetanse
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.DocumentsRead">
        <Authorized>
            <MudNavLink Href="@PageRoutes.UserDocuments.Overview"
                        Icon="@Icons.Material.Filled.Article"
                        Class="cv-nav-link">
                Mine dokumenter
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.EquipmentRead">
        <Authorized>
            <MudNavLink Href="@PageRoutes.UserEquipment.Overview"
                        Icon="@Icons.Material.Filled.Construction"
                        Class="cv-nav-link">
                Mitt utstyr
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    @if (_showAdminSection)
    {
        <MudDivider Class="my-4 mx-4 cv-nav-divider" />

        <MudText Typo="Typo.overline" Class="cv-nav-section-title px-4 mb-2">
            Administrasjon
        </MudText>
    }

    <!-- Brukere & roller -->
    <AuthorizeView Policy="@Permissions.UsersRead">
        <Authorized Context="usersAuth">
            <MudNavGroup Title="Brukere & roller"
                         Icon="@Icons.Material.Filled.PeopleAlt"
                         Class="cv-nav-group">
                <MudNavLink Href="@PageRoutes.Users.List"
                            Icon="@Icons.Material.Filled.People"
                            Class="cv-nav-link">
                    Brukere
                </MudNavLink>

                <AuthorizeView Policy="@Permissions.JobTitlesRead">
                    <Authorized>
                        <MudNavLink Href="@PageRoutes.JobTitles.List"
                                    Icon="@Icons.Material.Filled.Work"
                                    Class="cv-nav-link">
                            Stillinger
                        </MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.DepartmentsRead">
                    <Authorized>
                        <MudNavLink Href="@PageRoutes.Departments.List"
                                    Icon="@Icons.Material.Filled.Business"
                                    Class="cv-nav-link">
                            Avdelinger
                        </MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.RolesRead">
                    <Authorized>
                        <MudNavLink Href="@PageRoutes.Roles.List"
                                    Icon="@Icons.Material.Filled.Shield"
                                    Class="cv-nav-link">
                            Roller
                        </MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Kompetanse (admin) -->
    <AuthorizeView Policy="@Permissions.CompetenciesWrite">
        <Authorized>
            <MudNavGroup Title="Kompetanse"
                         Icon="@Icons.Material.Filled.FolderShared"
                         Class="cv-nav-group">
                <MudNavLink Href="@PageRoutes.CompetencyTypes.List"
                            Icon="@Icons.Material.Filled.Category"
                            Class="cv-nav-link">
                    Kompetansetyper
                </MudNavLink>
                <MudNavLink Href="@PageRoutes.Competencies.List"
                            Icon="@Icons.Material.Filled.WorkspacePremium"
                            Class="cv-nav-link">
                    Registrerte kompetanser
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Dokumenter (admin) -->
    <AuthorizeView Policy="@Permissions.DocumentsWrite">
        <Authorized>
            <MudNavGroup Title="Dokumenter"
                         Icon="@Icons.Material.Filled.Article"
                         Class="cv-nav-group">
                <MudNavLink Href="@PageRoutes.Documents.Overview"
                            Icon="@Icons.Material.Filled.Article"
                            Class="cv-nav-link">
                    Dokumentkategorier
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Utstyr (admin) -->
    <AuthorizeView Policy="@Permissions.EquipmentWrite">
        <Authorized>
            <MudNavGroup Title="Utstyr"
                         Icon="@Icons.Material.Filled.Handyman"
                         Class="cv-nav-group">
                <MudNavLink Href="@PageRoutes.EquipmentCategories.List"
                            Icon="@Icons.Material.Filled.Headset"
                            Class="cv-nav-link">
                    Utstyrskategorier
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- System -->
    <AuthorizeView Policy="@Permissions.AuditRead">
        <Authorized>
            <MudNavGroup Title="System"
                         Icon="@Icons.Material.Filled.Settings"
                         Class="cv-nav-group">
                <MudNavLink Href="@PageRoutes.Audit.List"
                            Icon="@Icons.Material.Filled.History"
                            Class="cv-nav-link">
                    Revisjonslogg
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private bool _showAdminSection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated == true)
            return;

        _showAdminSection =
            HasClaim(user, Permissions.UsersRead) ||
            HasClaim(user, Permissions.CompetenciesWrite) ||
            HasClaim(user, Permissions.DocumentsWrite) ||
            HasClaim(user, Permissions.EquipmentWrite) ||
            HasClaim(user, Permissions.AuditRead);

        if (_showAdminSection)
            StateHasChanged();
    }

    private static bool HasClaim(System.Security.Claims.ClaimsPrincipal user, string permission)
    {
        return user.HasClaim(Permissions.ClaimType, permission);
    }
}
