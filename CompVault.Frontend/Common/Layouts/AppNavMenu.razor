@* Standard navigasjonsmeny for MainLayout - AdminLayout har egen *@

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Hjem
    </MudNavLink>
    <AuthorizeView Policy="@Permissions.CompetenciesRead">
