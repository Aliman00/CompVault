                    <Authorized>
                        <MudNavLink Href="@PageRoutes.Admin.Dashboard" Icon="@Icons.Material.Filled.AdminPanelSettings">
                            Admin-panel
                        </MudNavLink>
                    </Authorized>
                </AuthorizeView>
