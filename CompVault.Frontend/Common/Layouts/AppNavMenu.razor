                        </MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@Permissions.RolesRead">
                    <Authorized>
                        <MudNavLink Href="@PageRoutes.Roles.List" Icon="@Icons.Material.Filled.Shield">
