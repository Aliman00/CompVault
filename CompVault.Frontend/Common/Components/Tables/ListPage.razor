@* Komponent som viser en listen på alle List-sidene *@
@typeparam TItem

<AppAlert @bind-Alert="Alert"/>

@if (IsLoading)
{
    <AppSpinner Class="pa-20"/>
}
else
{
    @Header

    <MudDataGrid Items="ServerData is null ? Items : null"
                 ServerData="ServerData"
                 Filterable="ServerData is null"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Square="true"
                 Bordered="true"
                 SortMode="ServerData is null ? SortMode.Multiple : SortMode.None"
                 FixedHeader="true"
                 Loading="IsLoading"
                 RowClick="RowClick"
                 RowsPerPage="RowsPerPage">
        <Columns>
            @Columns
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TItem"
                              RowsPerPageString="Rader pr side:" 
                              PageSizeOptions="new[] { 10, 20, 50, 100 }"/>
        </PagerContent>
    </MudDataGrid>
}

@code {
    /// <summary>
    /// En liste med verdiene som vises i tabellen (UserDto, CompetencyDto etc.)
    /// </summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    
    /// <summary>
    /// Server-side paginering hvis listen krever det
    /// </summary>
    [Parameter] public Func<GridState<TItem>, CancellationToken, Task<GridData<TItem>>>? ServerData { get; set; }
    
    /// <summary>
    /// Selve kolonnene
    /// </summary>
    [Parameter, EditorRequired] public RenderFragment? Columns { get; set; }
    
    /// <summary>
    /// Headeren kan være forskjellig, hvis kompontentene har forskjellige knapper
    /// </summary>
    [Parameter] public RenderFragment? Header { get; set; }
    
    /// <summary>
    /// Viser spinner mens siden laster
    /// </summary>
    [Parameter] public bool IsLoading { get; set; }
    
    /// <summary>
    /// Feilmeldinger og suksess meldinger vises her
    /// </summary>
    [Parameter] public AlertInfo? Alert { get; set; }
    
    /// <summary>
    /// Ved handlinger i Alert-en (Trykk på bort-knapp)
    /// </summary>
    [Parameter] public EventCallback<AlertInfo?> AlertChanged { get; set; }
    
    /// <summary>
    /// Hanlding som skjer når vi trykker på entiteter i tabellen
    /// </summary>
    [Parameter] public EventCallback<DataGridRowClickEventArgs<TItem>> RowClick { get; set; }
    
    /// <summary>
    /// Antall sider hvvis vi har paginering
    /// </summary>
    [Parameter] public int RowsPerPage { get; set; } = 20;
    
}