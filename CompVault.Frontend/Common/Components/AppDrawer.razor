@* Gjenbrukbar drawer fra MudBlazor *@

<MudDrawer Open="_isOpen"
          OpenChanged="OnDrawerOpenChanged"
          Elevation="2"
          ClipMode="DrawerClipMode.Always">
    @ChildContent
</MudDrawer>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _isOpen;

    protected override void OnParametersSet() => _isOpen = IsOpen;

    private async Task OnDrawerOpenChanged(bool verdi)
    {
        _isOpen = verdi;
        await IsOpenChanged.InvokeAsync(verdi);
    }
}