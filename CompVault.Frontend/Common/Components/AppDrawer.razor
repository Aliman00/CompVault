@* Gjenbrukbar drawer fra MudBlazor. NavMenu sendes inn via ChildContent slik at
   MainLayout og AdminLayout kan bruke sin egen navigasjon *@

<MudDrawer Open="_isOpen" OpenChanged="OnDrawerOpenChanged" Elevation="2" ClipMode="DrawerClipMode.Always">
    @* Headeren til sidebaren *@
    @ChildContent
</MudDrawer>

@code {
    // ======================== PARAMETERS ========================
    // Bool som bestemmer om Draweren er åpen
    [Parameter]
    public bool IsOpen { get; set; }
    
    // Forteller foreldre komponenten om draweren har blitt lukket innen ifra
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }
    
    // Her skal det en NavMenu, egen for MainLayout og egen for AdminLayout
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    
    // ======================== PRIVATE FIELD ========================
    private bool _isOpen;
    
    
    // ======================== LIFECYCLE ========================
    protected override void OnParametersSet() => _isOpen = IsOpen;
    
    // ======================== PRIVATE METHODS ========================
    
    private async Task OnDrawerOpenChanged(bool verdi)
    {
        _isOpen = verdi;
        await IsOpenChanged.InvokeAsync(verdi);
    }
}