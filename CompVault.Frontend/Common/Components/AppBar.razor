@inject CircuitUserContext UserContext

<MudAppBar Elevation="1">
    @if (ShowMenuButton)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="OnMenuButtonClick" />
    }

    <!-- Logo + app navn -->
    <MudLink Href="/dashboard"
             Underline="Underline.None"
             Color="Color.Inherit"
             Class="d-flex align-center">
        <AppLogo Class="app-header-logo" />
        <MudText Typo="Typo.h6"
                 Class="ml-2"
                 Style="font-weight:700; letter-spacing:-0.01em;">
            CompVault
        </MudText>
    </MudLink>

    <MudSpacer />

    <!-- Høyre side: profil + ev. ekstra innhold -->
    <div class="d-flex align-center gap-3">
        <MudText Typo="Typo.body2"
                 Color="Color.Inherit"
                 Class="d-none d-sm-block"
                 Style="opacity:0.9">
            @UserContext.FullName
        </MudText>

        @RightContent
    </div>
</MudAppBar>

@code {
    [Parameter] public bool ShowMenuButton { get; set; } = true;
    [Parameter] public EventCallback OnMenuButtonClick { get; set; }
    [Parameter] public RenderFragment? RightContent { get; set; }
}
