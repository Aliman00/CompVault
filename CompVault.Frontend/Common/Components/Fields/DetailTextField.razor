@using System.Linq.Expressions
@* Tekstfelt som bytter mellom lese- og redigeringsmodus. Generisk og brukes i alle skjemaer og for visning av data *@

<MudTextField Value="@(IsEditing ? Value : Value.DashIfEmpty())"
              ValueChanged="ValueChanged"
              Label="@Label"
              ReadOnly="!IsEditing"
              Variant="IsEditing ? Variant.Outlined : Variant.Text"
              For="For"
              Adornment="OnAdornmentClick.HasDelegate ? Adornment.End : Adornment.None"
              AdornmentIcon="@Icons.Material.Filled.OpenInNew"
              AdornmentAriaLabel="Naviger til lenke"
              OnAdornmentClick="OnAdornmentClick"
              HelperText="@HelperText"
              HelperTextOnFocus="@(HelperText != null)"/>

@code {
    // ===================== PARAMETER =====================
    /// <summary>
    /// Verdien for input - datatype
    /// </summary>
    [Parameter, EditorRequired] public string Value {get; set; } = string.Empty;
    
    /// <summary>
    /// Handling som skjer når verdi endres
    /// </summary>
    [Parameter] public EventCallback<string?> ValueChanged {get; set; }
    
    /// <summary>
    /// Label som vises over feltet (eller i feltet hvis ingen value)
    /// </summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    
    /// <summary>
    /// Endrer utseende i UI for å skille mellom redigering og visning
    /// </summary>
    [Parameter, EditorRequired] public bool IsEditing {get; set; }
    
    /// <summary>
    /// Kobling mot en egenskap i en modell for å vise DataAnnotations
    /// </summary>
    [Parameter] public Expression<Func<string>>? For {get; set; }
    
    // ===================== Adornment som lenke =====================
    /// <summary>
    /// Handling som skjer når adornment klikkes
    /// </summary>
    [Parameter] public EventCallback OnAdornmentClick { get; set; }
    
    /// <summary>
    /// Hjelpetekst som vises feltet når feltet er i fokus
    /// </summary>
    [Parameter] public string? HelperText { get; set; }

}
