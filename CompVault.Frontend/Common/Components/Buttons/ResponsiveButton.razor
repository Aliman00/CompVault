@* Viser kun ikon på mobil, hele knappen på desktop og tablet *@
<MudHidden Breakpoint="Breakpoint.SmAndUp">
    @* Kun ikon *@
    <MudTooltip Text="@Label">
        <MudIconButton Icon="@Icon"
                       Variant="Variant.Outlined"
                       Color="@Color"
                       OnClick="OnClick"/>
    </MudTooltip>
</MudHidden>
<MudHidden Breakpoint="Breakpoint.Xs">
    @* Hele knappen med ikon og tekst *@
    <MudButton StartIcon="@Icon"
               Variant="Variant.Outlined"
               Color="@Color"
               OnClick="OnClick">
        @Label
    </MudButton>
</MudHidden>

@code {
    /// <summary>
    /// Teksten inne i knappen
    /// </summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    
    /// <summary>
    /// Ønsket ikon til knappen
    /// </summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    
    /// <summary>
    /// Valgrfitt farge til knappen. Default er Color.Primary
    /// </summary>
    [Parameter] public Color Color { get; set; } = Color.Primary;
    
    /// <summary>
    /// Handling som skjer på klikk
    /// </summary>
    [Parameter] public EventCallback OnClick { get; set; }
}