@page "/AdminDashboard"
@using CompVault.Frontend.Common.Extensions
@using CompVault.Frontend.Features.Admin.Constants
@using CompVault.Frontend.Features.Admin.Components
@layout AdminLayout

<div class="dashboard-header">
    <MudText Typo="Typo.h5">Admin-dashboard</MudText>
    
    @if (_hiddenWidgets.Any())
    {
        <MudMenu StartIcon="@Icons.Material.Filled.VisibilityOff"
                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                 Label="@($"Skjulte widgets ({_hiddenWidgets.Count})")"
                 Variant="Variant.Outlined"
                 Size="Size.Small"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Dense="true">
            @foreach (var widget in _hiddenWidgets)
            {
                <MudMenuItem OnClick="() => ToggleWidget(widget)">
                    Vis @widget
                </MudMenuItem>
            }
        </MudMenu>
    }
</div>

<MudGrid Class="mb-4">
    @if (_showTotalUsers)
    {
        <MudItem xs="12" sm="4">
            <StatisticWidget Title="@AdminConstants.TotalUsers" 
                              Value="3 brukere"
                              Icon="@Icons.Material.Filled.People"
                              AccentColor="#2d7a4f"
                              IconBackgroundColor="#e8f5ee"
                              IsVisible="_showTotalUsers"
                              OnHide='() => ToggleWidget(AdminConstants.TotalUsers)'/>
        </MudItem>
    }
    @if (_showTotalRoles)
    {
        <MudItem xs="12" sm="4">
            <StatisticWidget Title="@AdminConstants.TotalRoles" 
                              Value="10 roller"
                              Icon="@Icons.Material.Filled.Shield"
                              AccentColor="#1e3a5f"
                              IconBackgroundColor="#e4eaf2"
                              IsVisible="_showTotalRoles"
                              OnHide='() => ToggleWidget(AdminConstants.TotalRoles)'/>
        </MudItem>
    }
    @if (_showTotalDepartments)
    {
        <MudItem xs="12" sm="4">
            <StatisticWidget Title="@AdminConstants.TotalDepartments" 
                              Value="2 avdelinger"
                              Icon="@Icons.Material.Filled.Business"
                              AccentColor="#c9a84c"
                              IconBackgroundColor="#faf3e0"
                              IsVisible="_showTotalDepartments"
                              OnHide='() => ToggleWidget(AdminConstants.TotalDepartments)'/>
        </MudItem>
    }
</MudGrid>




@code {
    // ======================== Injections ========================
    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;
    
    // ======================== Private felt ========================
    private readonly List<string> _hiddenWidgets = [];

    private bool _showTotalUsers = true;
    private bool _showTotalRoles = true;
    private bool _showTotalDepartments = true;
    
    // ======================== Lifecycle ========================
    
    /// <summary>
    /// Henter fra lokalstorage hvis det er første render
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadPreferencesAsync();
        StateHasChanged();
    }
    
    // ======================== Private metoder ========================
    /// <summary>
    /// Toggler om en widget er synlig i UI-en eller ikke
    /// </summary>
    private async Task ToggleWidget(string widgetName)
    {
        bool isCurrentlyVisible = !_hiddenWidgets.Contains(widgetName);

        SetWidgetVisibility(widgetName, !isCurrentlyVisible);

        if (isCurrentlyVisible)
            _hiddenWidgets.Add(widgetName);
        else
            _hiddenWidgets.Remove(widgetName);

        await SavePreferencesAsync();
    }
    
    /// <summary>
    /// Setter en widget til synlig
    /// </summary>
    private void SetWidgetVisibility(string widgetName, bool visible)
    {
        switch (widgetName)
        {
            case AdminConstants.TotalUsers: _showTotalUsers = visible;
                break;
            case AdminConstants.TotalRoles: _showTotalRoles = visible;
                break;
            case AdminConstants.TotalDepartments: _showTotalDepartments = visible;
                break;
        }
    }
    
    /// <summary>
    /// Lagrer skjuilte widgets lokalt i localstorage
    /// </summary>
    private async Task SavePreferencesAsync()
    {
        var hidden = string.Join(",", _hiddenWidgets);
        await JsRuntime.SetItemAsync(AdminConstants.StorageKey, hidden);
    }
    
    /// <summary>
    /// Henter skjulte widgets fra localstorage og legger de til i komponenten sin liste
    /// </summary>
    private async Task LoadPreferencesAsync()
    {
        var saved = await JsRuntime.GetItemAsync(AdminConstants.StorageKey);
        // Ingen lagrede skjulte widgets
        if (string.IsNullOrWhiteSpace(saved))
            return;

        foreach (var widgetName in saved.Split(','))
        {
            SetWidgetVisibility(widgetName, visible: false);
            _hiddenWidgets.Add(widgetName);
        }
    }
}