@* En widget som viser statistikk for innsendte verdier *@

@if (IsVisible)
{
    <MudPaper Class="pa-3" Style="@($"border-top: 3px solid {AccentColor};")" Elevation="1">
        <section class="widget-header">
            <div style="display: flex; align-items: center; gap: 6px;">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <div style="@($"width:36px; height:36px; border-radius:8px; background:{IconBackgroundColor}; " +
                                  $"display:flex; align-items:center; justify-content:center;")">
                        <MudIcon Icon="@Icon" Size="Size.Small" Style="@($"color:{AccentColor};")" />
                    </div>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Title</MudText>
            </div>
            <WidgetMenu OnHide="OnHide"/>
        </section>
        <MudText Typo="Typo.h4">@Value</MudText>
    </MudPaper>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string AccentColor { get; set; } = "";
    [Parameter] public string IconBackgroundColor { get; set; } = "";

    // Parameter som bestemmer om widgeten er synlig eller ikke
    [Parameter] public bool IsVisible { get; set; } = true;

    // Sender tilbake til foreldrekomponenten om OnHide i menyen har blitt trykket på
    [Parameter] public EventCallback OnHide { get; set; }
}