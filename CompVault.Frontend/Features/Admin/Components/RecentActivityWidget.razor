@* En widget som viser de siste handlingene i systemet - implementerer vi en Audit-log så kan det vises her *@
@* TODO: Bytt ut den hardkodete dataen *@

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <section class="widget-header">
        <MudText Typo="Typo.subtitle1">Siste aktivitet</MudText>
        <WidgetMenu OnHide="OnHide"/>
    </section>
        
    <MudList T="string" Dense="true" Padding="false">
        <MudListItem Dense="true">
            <MudText Typo="Typo.body2">Ny bruker opprettet - Jens Jaktrifle</MudText>
        </MudListItem>
    </MudList>
</MudPaper>

@code {
   

    // Sender tilbake til foreldrekomponenten om OnHide i menyen har blitt trykket på
    [Parameter] public EventCallback OnHide { get; set; }
}