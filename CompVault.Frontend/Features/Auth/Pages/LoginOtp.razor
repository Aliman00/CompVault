@page "/login-otp"  
@* -- Route: localhost:5020/login-otp?email=test@... *@
@inject IHttpClientFactory Http     
@inject NavigationManager Navigation 

<!-- Sentralisert OTP-kort -->
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem;background:#f5f5f5">
    <MudCard Style="width:400px">
        <MudCardContent Class="pa-6">
            <MudText Typo="Typo.h4" Class="mb-4 text-center">Bekreft OTP</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">Sendt til: <strong>@Email</strong></MudText>
            
            <!-- Vis e-post fra query-string (?email=...) -->
            <MudText Typo="Typo.body1" Class="mb-4">
                Sendt til: <strong>@Email</strong>
            </MudText>
            
            <!-- OTP-input (6 siffer) -->
            <MudTextField Label="OTP-kode (6 siffer)" 
                          @bind-Value="code" 
                          MaxLength="6"
                          Variant="Variant.Outlined" 
                          Immediate />
                          
            <!-- Verifiser mot backend -->
            <MudButton Class="mt-6" 
                       FullWidth 
                       Color="Color.Primary" 
                       Variant="Variant.Filled"
                       OnClick="VerifyOtpAsync">
                Logg inn
            </MudButton>
        </MudCardContent>
    </MudCard>
</div>

@code {

    // Hent e-post fra URL: /login-otp?email=test@example.com
    [Parameter] [SupplyParameterFromQuery] public string? Email { get; set; } = "";


    private string code = ""; // Two-way binding til input

    private async Task VerifyOtpAsync()
    {
        // Hent BackendApi-klient
        var client = Http.CreateClient("BackendApi");

        // POST OTP til din backend
        var response = await client.PostAsJsonAsync("api/auth/verify-otp",
            new { email = Email, code });

        // Ved suksess → dashboard (med forceLoad for auth)
        if (response.IsSuccessStatusCode)
            Navigation.NavigateTo("/dashboard", forceLoad: true);
    }

}