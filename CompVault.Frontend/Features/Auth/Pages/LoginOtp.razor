@page "/login-otp"
@layout AuthLayout
@inject IJSRuntime Js
@inject AntiforgeryStateProvider AntiforgeryStateProvider
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation 
@inject AuthStateService AuthState  

<!-- Sentralisert OTP-kort -->
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem;background:#f5f5f5">
    <MudCard Style="width:400px">
        <MudCardContent Class="pa-6">

            <MudText Typo="Typo.h4" Class="mb-4 text-center">Bekreft OTP</MudText>

            <!-- Vis e-post fra query-string (?email=...) -->
            <MudText Typo="Typo.body1" Class="mb-4">
                Sendt til: <strong>@Email</strong>
            </MudText>

            <!-- OTP-input (6 siffer) -->
            <MudTextField Label="OTP-kode (6 siffer)" 
                          @bind-Value="code" 
                          MaxLength="6"
                          Variant="Variant.Outlined" 
                          Immediate />

            <!-- Verifiser mot backend -->
            <MudButton Class="mt-6" 
                       FullWidth 
                       Disabled="@isDisabled" 
                       Color="Color.Primary" 
                       Variant="Variant.Filled"
                       OnClick="VerifyOtpAsync">
                Logg inn
            </MudButton>

            <!-- Feilmelding ved feil OTP eller lock -->
            @if (!string.IsNullOrEmpty(error))
            {
                <MudText Color="Color.Error" Class="mt-2">
                    @error
                </MudText>
            }
            
            @* Skjult form for å legge tokens i nettleseren ved innloging *@
            <form id="login-form" method="post" action="/login-callback">
                <AntiforgeryToken/>
                <input type="hidden" name="TokenResponse.AccessToken" id="access-token-input" value="" />
                <input type="hidden" name="TokenResponse.RefreshToken" id="refresh-token-input" value="" />
            </form>
        </MudCardContent>
    </MudCard>
</div>

@code {

    // Hent e-post fra URL: /login-otp?email=test@example.com
    [Parameter] 
    [SupplyParameterFromQuery] 
    public string? Email { get; set; } = "";

    private string code = "";   // Two-way binding til OTP input
    private string? error;      // Feilmelding til UI
    private bool isDisabled;    // Disable knapp ved lock
    private bool hasRedirected; // Hindrer redirect loop

    protected override void OnInitialized()
    {
        // Lytt på endringer i login state
        AuthState.OnChange += StateChanged;

        // Sett initial state
        UpdateState();
    }

    private void StateChanged()
    {
        // Kjør UI update async (Blazor pattern)
        InvokeAsync(UpdateState);
    }

    private void UpdateState()
    {
        // Disable knapp hvis bruker er låst
        isDisabled = !AuthState.CanAttemptLogin();

        // Hvis for mange feil forsøk → redirect tilbake til login
        if (AuthState.LoginState.IsLocked && !hasRedirected)
        {
            hasRedirected = true;

            error = "For mange feil forsøk. Du blir sendt tilbake.";

            // Litt delay for bedre UX
            Task.Run(async () =>
            {
                await Task.Delay(1500);
                Navigation.NavigateTo("/login-email", true);
            });
        }
    }
    
    private async Task VerifyOtpAsync()
    {
        // Stopper hvis bruker er låst
        if (!AuthState.CanAttemptLogin())
        {
            error = "Du er midlertidig låst.";
            return;
        }
        
        var request = new VerifyOtpRequest { Email = Email ?? "", OtpCode = code };
        var result = await AuthService.VerifyOtpAsync(request, Cts.Token);
        if (result.IsFailure)
        {
            AuthState.RegisterFailedLogin();
            error = "Feil OTP-kode.";
            return;
        }
        
        // Suksess → reset teller og submit skjult form
        AuthState.RegisterSuccess();

        var token = AntiforgeryStateProvider.GetAntiforgeryToken();
        await Js.InvokeVoidAsync("loginFormSubmit",
            result.Value!.AccessToken,
            result.Value.RefreshToken,
            token?.Value);
    }
    
    public override void Dispose()
    {
        AuthState.OnChange -= StateChanged;
        base.Dispose();
    }
}