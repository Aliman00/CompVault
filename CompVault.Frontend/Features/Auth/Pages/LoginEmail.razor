@page "/login-email"
@inject IHttpClientFactory Http     
@inject NavigationManager Navigation
@inject AuthStateService AuthState

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem;background:#f5f5f5">
    <MudCard Style="width:400px">
        <MudCardContent Class="pa-6">
            <MudText Typo="Typo.h4" Class="mb-6 text-center">Logg inn</MudText>

            <MudTextField Label="E-post (æøå OK)"
                          @bind-Value="email"
                          Variant="Variant.Outlined"
                          Immediate />

            <MudButton Class="mt-6"
                       FullWidth
                       Disabled="@isLocked"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="SendOtpAsync">
                Send OTP-kode
            </MudButton>

            @if (isLocked)
            {
                <MudText Color="Color.Error" Class="mt-2">
                    For mange forsøk. Prøv igjen senere.
                </MudText>
            }
        </MudCardContent>
    </MudCard>
</div>

@code {
    private string email = "";
    private bool isLocked;

    protected override void OnInitialized()
    {
        isLocked = !AuthState.CanAttemptLogin();
    }

    private async Task SendOtpAsync()
    {
        if (!AuthState.CanAttemptLogin())
            return;

        var client = Http.CreateClient("BackendApi");

        await client.PostAsJsonAsync("api/auth/request-otp", new { email });

        Navigation.NavigateTo($"/login-otp?email={Uri.EscapeDataString(email)}");
    }
}