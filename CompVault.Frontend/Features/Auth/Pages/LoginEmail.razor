@page "/"
@layout AuthLayout

@inject IHttpClientFactory Http
@inject NavigationManager Navigation
@inject AuthStateService AuthState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Logg inn – CompVault</PageTitle>

<div class="cv-login-page">
    <MudCard Class="cv-login-card" Elevation="8">
        <MudCardContent Class="pa-8">
            <div class="cv-login-header">
                <MudImage Src="images/CompVault.png"
                          Alt="CompVault Logo"
                          Height="140"
                          ObjectFit="ObjectFit.Contain" />
                <MudText Typo="Typo.h4" Class="mt-4">Velkommen til CompVault</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                    Logg inn med din e-postadresse
                </MudText>
            </div>

            <MudDivider Class="my-6" />

            <MudTextField T="string"
                          Label="E-postadresse"
                          @bind-Value="email"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Email"
                          Disabled="@isLocked"
                          Error="@(!string.IsNullOrEmpty(_error))"
                          ErrorText="@_error" />

            @if (isLocked)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">
                    For mange forsøk. Prøv igjen senere.
                </MudAlert>
            }

            <MudButton Class="mt-6"
                       FullWidth
                       Disabled="@isLocked"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Large"
                       OnClick="SendOtpAsync"
                       StartIcon="@Icons.Material.Outlined.Login">
                Send engangskode
            </MudButton>

            <MudText Typo="Typo.caption"
                     Align="Align.Center"
                     Class="mt-4 d-block"
                     Color="Color.Secondary">
                Du vil motta en engangskode på e-post
            </MudText>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private string email = "";
    private string _error = "";
    private bool isLocked;

    protected override void OnInitialized()
    {
        isLocked = !AuthState.CanAttemptLogin();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/dashboard");
    }

    private async Task SendOtpAsync()
    {
        _error = "";

        if (string.IsNullOrWhiteSpace(email))
        {
            _error = "E-postadresse er påkrevd";
            return;
        }

        if (!AuthState.CanAttemptLogin())
            return;

        var client = Http.CreateClient("BackendApi");
        await client.PostAsJsonAsync("api/auth/request-otp", new { email });

        Navigation.NavigateTo($"/login-otp?email={Uri.EscapeDataString(email)}");
    }
}