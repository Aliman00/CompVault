@page "/departments"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.DepartmentsRead)]
@inject IDepartmentService DepartmentService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

@* Side for liste visning av alle avdelinger *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else
{
    <ListHeader Title="Avdelinger"
            CreateHref="@PageRoutes.Departments.DepartmentsCreate"
            CreateLabel="Opprett avdeling"
            CreateIcon="@Icons.Material.Filled.CorporateFare"
            CreatePolicy="@Permissions.DepartmentsWrite">
        <Actions>
            <MudToggleIconButton Toggled="_showDepartmentTree"
                                 ToggledChanged="ToggleTreeView"
                                 Icon="@Icons.Material.Outlined.AccountTree"
                                 ToggledIcon="@Icons.Material.Filled.TableRows"
                                 Title="Bytt til hierarki-visning"
                                 ToggledTitle="Bytt til liste"
                                 Class="mr-2"/>
        </Actions>
    </ListHeader>

    @if (!_showDepartmentTree)
    {
        @* Grid med liste over avdelinger *@
        <MudDataGrid Items="_department"
                     Filterable="true"
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                     Dense="true"
                     Hover="true"
                     Striped="true"
                     Square="true"
                     Bordered="true"
                     SortMode="SortMode.Multiple"
                     FixedHeader="true"
                     Loading="_isLoading"
                     MultiSelection="true"
                     @bind-SelectedItems="_selectedDepartments"
                     RowClick="@((DataGridRowClickEventArgs<DepartmentDto> args) => OnDepartmentClick(args.Item.Id))">

            @* Headeren til listen - Inneholder knappene for å utføre handlinger på en eller flere avdelinger *@
            @* For øyeblikket kun Rediger-avdeling knapp som er disabled hvis bruker ikke har department:write tilgang*@

            @* Selve kolonnene *@
            <Columns>
                <SelectColumn T="DepartmentDto"/>
                <PropertyColumn Property="departmentDto => departmentDto.Name" Title="Navn"/>
                <PropertyColumn Property="departmentDto => departmentDto.ParentDepartmentName" Title="Overordnet avdeling"/>
                <PropertyColumn Property="departmentDto => departmentDto.SubDepartmentCount" Title="Underavdelinger"/>
                <TemplateColumn Title="Status" Sortable="true" SortBy="@(departmentDto => departmentDto.IsActive)">
                    <CellTemplate>
                        <MudChip T="string"
                                 Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                 Size="Size.Small">
                            @(context.Item.IsActive ? "Aktiv" : "Inaktiv")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
    else
    {
        @* Hierarkisk trevisning av avdelinger *@
        <MudPaper Elevation="1" Square="true" Class="pa-4">
            <DepartmentTree Departments="_department" OnNavigate="OnDepartmentClick"/>
        </MudPaper>
    }
}



@code {
    // ===================== PARAMETER =====================
    [SupplyParameterFromQuery(Name = "deleted")]
    public bool Deleted { get; set; }
    
    // ===================== PRIVATE FELT =====================
    private List<DepartmentDto> _department = [];
    private HashSet<DepartmentDto> _selectedDepartments = [];
    
    private bool _isLoading = true;
    private AlertInfo? _alert;
    public bool _showDepartmentTree;
    
    // ===================== LIFECYCLE =====================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var getDepartmentResults = await DepartmentService.GetAllAsync(Cts.Token);

            if (getDepartmentResults.IsFailure)
            {
                _alert = new AlertInfo(getDepartmentResults.Error!.ToString(), Severity.Error);
                return;
            }

            _department = getDepartmentResults.Value!;
            
            if (Deleted)
                _alert = new AlertInfo("Avdelingen er slettet", Severity.Info);
            
            var stored = await JsRuntime.GetItemAsync(AppConstants.DepartmentTreeViewKey);
            if (stored != null)
                _showDepartmentTree = stored == "true";
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste avdelinger. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    // ===================== PRIVATE METHODS =====================
    
    // Navigerer ved å sende UserDto via NavigationManager (ikke via URL-en, men som en string i nettlesere)
    private void OnDepartmentClick(Guid id) =>
        NavigationManager.NavigateTo(PageRoutes.Departments.DepartmentsDetail(id));
    
    private async Task ToggleTreeView(bool value)
    {
        _showDepartmentTree = value;
        await JsRuntime.SetItemAsync(AppConstants.DepartmentTreeViewKey, value.ToString().ToLower());
    }
    
}