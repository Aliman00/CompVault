@page "/equipment-categories/create"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.EquipmentWrite)]
@inject IEquipmentCategoryService EquipmentCategoryService
@inject NavigationManager NavigationManager

@* Side for å opprette en dokumenttype *@

<CreateForm Title="Opprett utstyrskategori"
            EditContext="_editContext"
            OnValidSubmit="CreateEquipmentCategory"
            @bind-Alert="_alert">
    <Fields>
        @* Navn *@
        <MudItem xs="12" sm="6">
            <TextField Value="@_editModel.Name"
                             ValueChanged="(string? v) => _editModel.Name = v ?? string.Empty"
                             Label="Navn"
                             IsEditing="true"
                             For="() => _editModel.Name"/>
        </MudItem>
        
        @* Beskrivelse *@
        <MudItem xs="12">
            <TextField Value="@_editModel.Description"
                             ValueChanged="(string? v) => _editModel.Description = v"
                             Label="Beskrivelse (valgfritt)"
                             IsEditing="true"
                             For="() => _editModel.Description"
                             Lines="4"/>
        </MudItem>
        
    </Fields>
</CreateForm>

@code {
    // ===================== PRIVATE FELT =====================
    private readonly CreateEquipmentCategoryModel _editModel = new();

    private AlertInfo? _alert;

    private EditContext _editContext = null!;

    protected override Task OnInitializedAsync()
    {
        _editContext = new EditContext(_editModel);
        return Task.CompletedTask;
    }

    // ===================== PRIVATE METHODS =====================

    // Handlign som skjer når vi trykker på opprett-knappen. Utfører et API-kall og
    // navigerer oss til detalje-siden
    private async Task CreateEquipmentCategory()
    {
        var request = _editModel.ToRequest();

        var createResult = await EquipmentCategoryService.CreateAsync(request, Cts.Token);
        if (createResult.IsFailure)
        {
            _alert = new AlertInfo(createResult.Error!.ToString(), Severity.Error);
            return;
        }

        NavigationManager.NavigateTo(
            PageRoutes.EquipmentCategories.Detail(createResult.Value!.Id) + "?created=true", replace: true);
    }
}
