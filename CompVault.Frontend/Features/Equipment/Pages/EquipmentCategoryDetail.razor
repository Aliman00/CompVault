@page "/equipment-categories/{Id:guid}"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.EquipmentRead)]
@inject IEquipmentCategoryService EquipmentCategoryService
@inject IEquipmentItemService EquipmentItemService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

@* Detalje visning av en utstyrskategori med mulighet for oppdatering *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else if (_equipmentCategory != null)
{
    <DetailForm Title="@_equipmentCategory?.Name"
                Subtitle="@_equipmentCategory?.Description"
                EditPolicy="@Permissions.EquipmentWrite"
                EditContext="_editContext"
                OnValidSubmit="SaveEdit"
                IsEditing="_isEditing"
                OnStartEdit="StartEdit"
                OnCancelEdit="CancelEdit">
        <DropdownActions>
            <AuthorizeView Policy="@Permissions.EquipmentDelete">
                <Authorized>
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                 IconColor="Color.Error"
                                 OnClick="Delete">
                        <MudText Color="Color.Error">Slett utstyrskategori</MudText>
                    </MudMenuItem>
                </Authorized>
                <NotAuthorized>
                    <MudTooltip Text="Du har ikke tilgang til å slette utstyrskategorien">
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                     IconColor="Color.Default"
                                     Disabled="true">
                            <MudText>Slett utstyrskategori</MudText>
                        </MudMenuItem>
                    </MudTooltip>
                </NotAuthorized>
            </AuthorizeView>
        </DropdownActions>
        <Fields>
            @* Navn *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_editModel.Name"
                           ValueChanged="(string? v) => _editModel.Name = v ?? string.Empty"
                           Label="Navn"
                           IsEditing="_isEditing"
                           For="() => _editModel.Name"/>
            </MudItem>
          
            @* Beskrivelse *@
            <MudItem xs="12">
                <TextField Value="@_editModel.Description"
                           ValueChanged="(string? v) => _editModel.Description = v ?? string.Empty"
                           Label="Beskrivelse (valgfritt)"
                           IsEditing="_isEditing"
                           For="() => _editModel.Description"/>
            </MudItem>
            
            @* Status *@
            <MudItem xs="12" sm="6">
                <ToggleButton Label="Status"
                              @bind-Value="_editModel.IsActive"
                              IsEditing="_isEditing">
                    <MudToggleItem Value="(bool?)true" Text="Aktiv"/>
                    <MudToggleItem Value="(bool?)false" Text="Inaktiv"/>
                </ToggleButton>
            </MudItem>
            
            @* Opprettelsesdato *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_equipmentCategory!.CreatedAt.ToString(CultureInfo.InvariantCulture)"
                           Label="Opprettet"
                           IsEditing="false"/>
            </MudItem>
            
            @* EquipmentItems med denne kategorien *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1">
                    Utstyr av type @_equipmentCategory!.Name (@_equipmentCategory.ItemCount stk)
                </MudText>
                <MudDataGrid T="EquipmentItemDto"
                             Items="_equipmentItems"
                             Filterable="false"
                             Dense="true"
                             Hover="true"
                             Striped="true"
                             Square="true"
                             Bordered="true"
                             SortMode="SortMode.Single"
                             RowClick="@((DataGridRowClickEventArgs<EquipmentItemDto> args)
                                           => NavigateToEquipmentItem(args.Item.Id))">
                    <Columns>
                        <PropertyColumn Property="x => x.Name" Title="Navn"/>
                        <TemplateColumn Title="Har størrelse">
                            <CellTemplate>
                                <MudIcon Icon="@(context.Item.HasSize
                                                   ? Icons.Material.Filled.CheckCircle
                                                   : Icons.Material.Filled.Cancel)"
                                         Color="@(context.Item.HasSize ? Color.Success : Color.Default)"/>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string"
                                         Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                         Size="Size.Small">
                                    @(context.Item.IsActive ? "Aktiv" : "Inaktiv")
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
        </Fields>
    </DetailForm>
}

@code {

    // ===================== PARAMETER =====================
    [Parameter, EditorRequired] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "created")] // Optional parameter ved vellykket oppretting
    public bool Created { get; set; }

    // ===================== PRIVATE FELT =====================
    private EquipmentCategoryDto? _equipmentCategory;
    private List<EquipmentItemDto> _equipmentItems = [];

    private EquipmentCategoryEditModel _editModel = new();

    private bool _isLoading = true;

    // Forskjellige feilmeldinger for forkjellige beskjeder
    private AlertInfo? _alert;

    private EditContext _editContext = null!;

    private bool _isEditing; // Bool som bytter feltene mellom lese-modus og redigeringsmodus

    // ===================== LIFECYCLE =====================
    protected override async Task OnParametersSetAsync()
    {
        // Resetter alle feltene ved oppdatering/navigering til siden
        _isLoading = true;
        _isEditing = false;
        _equipmentItems = [];
        _editModel = new();

        try
        {
            _editContext = new EditContext(_editModel);
            
            var equipmentCategoryTask = EquipmentCategoryService.GetByIdAsync(Id, Cts.Token);
            var equipmentItemTask = EquipmentItemService.GetByCategoryAsync(Id, Cts.Token);
            
            await Task.WhenAll(equipmentItemTask, equipmentCategoryTask);

            var equipmentCategoryResult = await equipmentCategoryTask;
            var equipmentItemResult = await equipmentItemTask;

            if (equipmentCategoryResult.IsFailure)
            {
                _alert = new AlertInfo(equipmentCategoryResult.Error!.ToString(), Severity.Error);
                return;
            }

            _equipmentCategory = equipmentCategoryResult.Value;

            if (equipmentItemResult.IsFailure)
                _alert = new AlertInfo(equipmentItemResult.Error!.ToString(), Severity.Error);
            else
                _equipmentItems = equipmentItemResult.Value!;

            ResetEditModel();
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste utstyrskategorien. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;

            if (Created)
                _alert = new AlertInfo("Utstyrskategorien ble opprettet", Severity.Success);
        }
    }

    // ===================== PRIVATE METHODS =====================

    // Handling når vi trykker på Edit-knappen. Fjerner feilmeldinger og resetter modell
    private void StartEdit()
    {
        _alert = null;
        ResetEditModel();
        _isEditing = true;
    }

    // Handling når vi avbryter redigering - Resetter modellene og fjerner redigeringsmodus
    private void CancelEdit()
    {
        ResetEditModel();
        _isEditing = false;
    }

    // Resetter redigeringsmodellen og editcontexten
    private void ResetEditModel()
    {
        _editModel = EquipmentCategoryEditModel.FromDto(_equipmentCategory!);
        _editContext = new EditContext(_editModel);
    }

    // Handling som utføres når vi trykker på lagring - Bygger en request og utfører kall til backend
    private async Task SaveEdit()
    {
        var request = _editModel.ToRequest();

        var updateResult = await EquipmentCategoryService.UpdateAsync(Id, request, Cts.Token);
        if (updateResult.IsFailure)
        {
            _alert = new AlertInfo(updateResult.Error!.ToString(), Severity.Error);
            return;
        }

        // Resetter feltene kun hvis det var vellykket
        _equipmentCategory = updateResult.Value;
        ResetEditModel();
        _isEditing = false;
        _alert = new AlertInfo("Utstyrskategorien ble oppdatert", Severity.Success);
    }

    private void NavigateToEquipmentItem(Guid equipmentId) =>
        NavigationManager.NavigateTo(PageRoutes.EquipmentItems.Detail(equipmentId));

    // Viser en dialog som brukeren må godkjenne for å kunne slette entiteten. Navigerer til List-siden hviss vellykket
    private async Task Delete()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDeleteDialog.Title), "Slett utstyrskategorien" },
            { nameof(ConfirmDeleteDialog.Message), $"Er du sikker på at du ønsker å slette {_equipmentCategory!.Name}?" },
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        var deleteResult = await EquipmentCategoryService.DeleteAsync(Id, Cts.Token);
        if (deleteResult.IsFailure)
        {
            _alert = new AlertInfo(deleteResult.Error!.ToString(), Severity.Error);
            return;
        }

        NavigationManager.NavigateTo(PageRoutes.EquipmentCategories.List + "?deleted=true");
    }
}