@page "/documents/{Slug}/{Id:guid}"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.DocumentsRead)]
@attribute [Authorize(Policy = Permissions.AdminAccess)]
@inject IDocumentTypeService DocumentTypeService
@inject IDocumentService DocumentService
@inject IDocumentTypeCategoryService DocumentTypeCategoryService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IDepartmentService DepartmentService
@inject IJobTitleService JobTitleService
@inject ISignatureService SignatureService
@inject CircuitUserContext CircuitUser

@* Detalje visning av et dokument med oppdatering og fornying av et dokument ved ny versjon *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else if (_document != null && _documentType != null)
{
    <DetailForm Title="@_document?.Title"
                Subtitle="@_document?.Description"
                EditPolicy="@Permissions.DocumentsWrite"
                EditContext="_editContext"
                OnValidSubmit="SaveEdit"
                IsEditing="_isEditing"
                OnStartEdit="StartEdit"
                OnCancelEdit="CancelEdit">
        <ExtraActions>
            <AuthorizeView Policy="@Permissions.DocumentsWrite">
                <Authorized>
                    <ResponsiveButton Label="Last opp ny versjon"
                                      Icon="@Icons.Material.Filled.Upload"
                                      OnClick="UpdateDocumentVersion"/>
                </Authorized>
                <NotAuthorized>
                    <MudTooltip Text="Du har ikke tilgang til å laste opp ny versjon">
                        <ResponsiveButton Label="Last opp ny versjon"
                                          Icon="@Icons.Material.Filled.Upload"
                                          Disabled="true"/>
                    </MudTooltip>
                </NotAuthorized>
            </AuthorizeView>
        </ExtraActions>
        <DropdownActions>
            <AuthorizeView Policy="@Permissions.DocumentsDelete">
                <Authorized>
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                 IconColor="Color.Error"
                                 OnClick="Delete">
                        <MudText Color="Color.Error">Slett dokumentet</MudText>
                    </MudMenuItem>
                </Authorized>
                <NotAuthorized>
                    <MudTooltip Text="Du har ikke tilgang til å slette dokumentet">
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                     IconColor="Color.Default"
                                     Disabled="true">
                            <MudText>Slett dokumentet</MudText>
                        </MudMenuItem>
                    </MudTooltip>
                </NotAuthorized>
            </AuthorizeView>
        </DropdownActions>
        <Fields>
            @* Tittel *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_editModel.Title"
                           ValueChanged="(string? v) => _editModel.Title = v ?? string.Empty"
                           Label="Tittel"
                           IsEditing="_isEditing"
                           For="() => _editModel.Title"/>
            </MudItem>

            @* Kategori *@
            @if (_documentTypeCategories.Count > 0)
            {
                <MudItem xs="12" sm="6">
                    <SelectWithLinkField Value="_editModel.DocumentTypeCategoryId"
                                         ValueChanged="(Guid? v) => _editModel.DocumentTypeCategoryId = v"
                                         Label="Underkategori (valgfritt)"
                                         ToStringFunc="@(id => _documentTypeCategories.FirstOrDefault(
                                                           c => c.Id == id)?.Name ?? string.Empty)"
                                         IsEditing="_isEditing"
                                         ShowLink="false"
                                         DisplayValue="@(_documentTypeCategories.
                                                       FirstOrDefault(c => c.Id == _document?.DocumentTypeCategoryId)?.Name)">
                        <Items>
                            <MudSelectItem Value="(Guid?)null">Ingen kategori</MudSelectItem>
                            @foreach (var category in _documentTypeCategories)
                            {
                                <MudSelectItem Value="(Guid?)category.Id">@category.Name</MudSelectItem>
                            }
                        </Items>
                    </SelectWithLinkField>
                </MudItem>
            }
                
            @* Beskrivelse *@
            <MudItem xs="12">
                <TextField Value="@_editModel.Description"
                           ValueChanged="(string? v) => _editModel.Description = v"
                           Label="Beskrivelse (valgfritt)"
                           IsEditing="_isEditing"
                           For="() => _editModel.Description"
                           Lines="4"/>
            </MudItem>

            @* RequireSignature *@
            <MudItem xs="12" sm="6">
                <ToggleButton Label="Krever dokumentet signatur?"
                              @bind-Value="_editModel.RequiresSignature"
                              IsEditing="_isEditing">
                    <MudToggleItem Value="(bool?)true" Text="Krever signatur"/>
                    <MudToggleItem Value="(bool?)false" Text="Ingen signatur"/>
                </ToggleButton>
            </MudItem>

            @* Filinformasjon hvis fil er lastet opp *@
            @if (_document!.HasFile)
            {
                <MudItem xs="12" sm="6">
                    <DocumentFileCard DocumentFileRecord="_document.ToFileInfo()!"/>
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="6">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Ingen fil er lastet opp for dette dokumentet.
                    </MudAlert>
                </MudItem>
            }

            @* ExternalURL *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_editModel.ExternalUrl"
                           ValueChanged="(string? v) => _editModel.ExternalUrl = v ?? string.Empty"
                           Label="Ekstern lenke (valgfritt)"
                           IsEditing="_isEditing"
                           For="() => _editModel.ExternalUrl"
                           OnAdornmentClick="NavigateToExternalUrl"
                           ShowLink="@(!string.IsNullOrWhiteSpace(_document?.ExternalUrl))"/>
            </MudItem>
            
            @if (HasInconsistentTargeting)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Dokumentets målgruppe stemmer ikke med dokumentkategoriens innstillinger.
                        Rediger dokumentet og oppdater målgruppen.
                    </MudAlert>
                </MudItem>
            }
            
            @* Avdelinger som målgruppe *@
            @if (_documentType!.TargetMode == DocumentTargetMode.Department)
            {
                @if (HasInactiveDepartments)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            En eller flere målgruppe-avdelinger er inaktive. Vennligst oppdater målgruppen.
                        </MudAlert>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MultiSelectField T="Guid"
                                      SelectedValues="_editModel.TargetDepartmentIds"
                                      SelectedValuesChanged="(List<Guid> v) => _editModel.TargetDepartmentIds = v"
                                      Label="Målgruppe - avdelinger"
                                      IsEditing="_isEditing"
                                      ToStringFunc="@(id => _departments
                            .FirstOrDefault(d => d.Id == id)?.Name.Truncate(40) ?? "⚠ Inaktiv avdeling")"
                                      OnChipClicked="(Guid id) => NavigationManager.NavigateTo(
                                      PageRoutes.Departments.Detail(id))">
                        <Items>
                            @foreach (var department in _departments
                                              .Where(d => !d.IsActive
                                                          && _editModel.TargetDepartmentIds.Contains(d.Id)))
                            {
                                <MudSelectItem T="Guid" Value="department.Id">
                                    ⚠ @department.Name (inaktiv)
                                </MudSelectItem>
                            }
                            @foreach (var department in _departments.Where(d => d.IsActive))
                            {
                                <MudSelectItem T="Guid" Value="department.Id">@department.Name</MudSelectItem>
                            }
                        </Items>
                    </MultiSelectField>
                </MudItem>
            }

            @* Stillinger som målgruppe *@
            @if (_documentType.TargetMode == DocumentTargetMode.JobTitle)
            {
                @if (HasInactiveJobTitles)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            En eller flere målgruppe-stillinger er inaktive. Vennligst oppdater målgruppen.
                        </MudAlert>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MultiSelectField T="Guid"
                                      SelectedValues="_editModel.TargetJobTitleIds"
                                      SelectedValuesChanged="(List<Guid> v) => _editModel.TargetJobTitleIds = v"
                                      Label="Målgruppe - stillinger"
                                      IsEditing="_isEditing"
                                      ToStringFunc="@(id => _jobTitles
                            .FirstOrDefault(j => j.Id == id)?.Name.Truncate(40) ?? "⚠ Inaktiv stilling")"
                                      OnChipClicked="(Guid id) => NavigationManager.NavigateTo(
                                      PageRoutes.JobTitles.Detail(id))">
                        <Items>
                            @foreach (var jobTitle in _jobTitles.Where(j => !j.IsActive
                                                                            && _editModel.TargetJobTitleIds.Contains(j.Id)))
                            {
                                <MudSelectItem T="Guid" Value="jobTitle.Id">⚠ @jobTitle.Name (inaktiv)</MudSelectItem>
                            }
                            @foreach (var jobTitle in _jobTitles.Where(j => j.IsActive))
                            {
                                <MudSelectItem T="Guid" Value="jobTitle.Id">@jobTitle.Name</MudSelectItem>
                            }
                        </Items>
                    </MultiSelectField>
                </MudItem>
            }
            
            @if (_document!.RequiresSignature)
            {
                <MudItem xs="12">
                    @* Egen melding hvis vi har singert/ikke signert *@
                    <DocumentSignatureStatusAlert CurrentUserMustSign="CurrentUserMustSign"
                                                  CurrentUserHasSigned="CurrentUserHasSigned"
                                                  SignatureVersion="CurrentUserSignature?.SignatureVersion"
                                                  DocumentVersion="_document!.Version"/>

                    @* Header *@
                    <ListHeader Title="@($"Signaturer - {_signatures.Count(s => s.HasSigned)} " +
                                         $"av {_signatures.Count} har signert")"
                                PageIcon="@Icons.Material.Filled.HistoryEdu">
                        <Actions>
                            @if (CurrentUserMustSign && !CurrentUserHasSigned)
                            {
                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Draw"
                                           OnClick="SignDocument">
                                    Signer dokumentet
                                </MudButton>
                            }
                        </Actions>
                    </ListHeader>

                    <MudDataGrid T="UserSignatureStatusDto"
                                 Items="_signatures"
                                 Dense="true"
                                 Hover="true"
                                 Striped="true"
                                 Square="true"
                                 Bordered="true"
                                 SortMode="SortMode.Single">
                        <Columns>
                            <TemplateColumn T="UserSignatureStatusDto" Title="Navn">
                                <CellTemplate>
                                    <MudLink Href="@PageRoutes.Users.Detail(context.Item.UserId)">
                                        @context.Item.FullName
                                    </MudLink>
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn T="UserSignatureStatusDto"
                                            Title="Versjon"
                                            SortBy="x => x.SignatureVersion">
                                <CellTemplate>
                                    @(context.Item.SignatureVersion.HasValue ? $"{context.Item.SignatureVersion}" : "—")
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn T="UserSignatureStatusDto"
                                            Title="Signert"
                                            SortBy="x => x.SignedAt">
                                <CellTemplate>
                                    @if (context.Item.SignedAt.HasValue)
                                    {
                                        <MudTooltip Text="@context.Item.SignedAt.Value.ToString("dd.MM.yyyy HH:mm")">
                                            @context.Item.SignedAt.Value.ToRelativeNorwegian()
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudText Color="Color.Error">Ikke signert</MudText>
                                    }
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn T="UserSignatureStatusDto" Title="" HeaderStyle="width: 40px;">
                                <CellTemplate>
                                    @if (context.Item.HasSigned && context.Item.SignatureVersion < _document.Version)
                                    {
                                        <MudTooltip Text="Signerte en eldre versjon">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning"
                                                     Color="Color.Warning"
                                                     Size="Size.Small"/>
                                        </MudTooltip>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudItem>
            }
            
        </Fields>
    </DetailForm>
}

@code {

    // ===================== PARAMETER =====================
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "created")] // Optional parameter ved vellykket oppretting av entiteten
    public bool Created { get; set; }

    // ===================== PRIVATE FELT =====================
    private DocumentDto? _document;
    private DocumentTypeDto? _documentType;
    private List<DocumentTypeCategoryDto> _documentTypeCategories = [];
    private List<DepartmentDto> _departments = [];
    private List<JobTitleDto> _jobTitles = [];
    private List<UserSignatureStatusDto> _signatures = [];

    private DocumentEditModel _editModel = new();

    private bool _isLoading = true;

    // Forskjellige feilmeldinger for forkjellige beskjeder
    private AlertInfo? _alert;

    private EditContext _editContext = null!;

    private bool _isEditing; // Bool som bytter feltene mellom lese-modus og redigeringsmodus
    
    // Vi sjekker om typen til dokumentet har endret målgruppe og dokumentet ikke er oppdatert
    private bool HasInconsistentTargeting =>
        _documentType != null && _document != null &&
        (
            (_documentType.TargetMode == DocumentTargetMode.Department && _document.TargetJobTitleIds.Count > 0) ||
            (_documentType.TargetMode == DocumentTargetMode.JobTitle && _document.TargetDepartmentIds.Count > 0) ||
            (_documentType.TargetMode == DocumentTargetMode.None && 
             (_document.TargetDepartmentIds.Count > 0 || _document.TargetJobTitleIds.Count > 0))
        );
    
    // Vi henter innlogget bruker sin UserSignatureStatusDto og deretter sjekker vi om brukeren har singert eller ikke
    private UserSignatureStatusDto? CurrentUserSignature =>
        _signatures.FirstOrDefault(s => s.UserId == CircuitUser.UserId);
    private bool CurrentUserMustSign => CurrentUserSignature != null;
    private bool CurrentUserHasSigned => CurrentUserSignature?.HasSigned == true;

    // ===================== LIFECYCLE =====================
    protected override async Task OnParametersSetAsync()
    {
        // Resetter alle feltene ved oppdatering/navigering til siden
        _isLoading = true;
        _isEditing = false;
        _documentType = new();
        _documentTypeCategories = [];
        _editModel = new();
        _departments = [];
        _jobTitles = [];
        _signatures = [];

        try
        {
            _editContext = new EditContext(_editModel);

            // Henter dokumenttype og dokumenter til denne typen
            var documentTask = DocumentService.GetByIdAsync(Slug, Id, Cts.Token);
            var documentTypeTask = DocumentTypeService.GetBySlugAsync(Slug, Cts.Token);
            var documentTypeCategoriesTask = DocumentTypeCategoryService.GetAllAsync(Slug, Cts.Token);
            var departmentsTask = DepartmentService.GetAllAsync(Cts.Token);
            var jobTitlesTask = JobTitleService.GetAllAsync(Cts.Token);
            var signatureTask = SignatureService.GetSignaturesAsync(Slug, Id, Cts.Token);


            await Task.WhenAll(documentTypeTask, documentTask, documentTypeCategoriesTask, departmentsTask,
                jobTitlesTask, signatureTask);

            var documentResult = await documentTask;
            var documentTypeResult = await documentTypeTask;
            var documentTypeCategoriesResult = await documentTypeCategoriesTask;
            var jobTitlesResult = await jobTitlesTask;
            var departmentsResult = await departmentsTask;
            var signatureResult = await signatureTask;

            if (documentResult.IsFailure)
            {
                _alert = new AlertInfo(documentResult.Error!.ToString(), Severity.Error);
                return;
            }

            _document = documentResult.Value;

            if (documentTypeResult.IsFailure)
                _alert = new AlertInfo(documentTypeResult.Error!.ToString(), Severity.Error);
            else
                _documentType = documentTypeResult.Value!;

            if (documentTypeCategoriesResult.IsFailure)
                _alert = new AlertInfo(documentTypeCategoriesResult.Error!.ToString(), Severity.Error);
            else
                _documentTypeCategories = documentTypeCategoriesResult.Value!;
            
            if (departmentsResult.IsFailure)
                _alert = new AlertInfo(departmentsResult.Error!.ToString(), Severity.Error);
            else
                _departments = departmentsResult.Value!;
            
            if (jobTitlesResult.IsFailure)
                _alert = new AlertInfo(jobTitlesResult.Error!.ToString(), Severity.Error);
            else
                _jobTitles = jobTitlesResult.Value!;
            
            if (signatureResult.IsFailure)
                _alert = new AlertInfo(signatureResult.Error!.ToString(), Severity.Error);
            else
                _signatures = signatureResult.Value!;


            ResetEditModel();
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste dokumentkategorien. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;

            if (Created)
                _alert = new AlertInfo("Dokumentkategorien ble opprettet", Severity.Success);
        }
    }

    // ===================== PRIVATE METHODS =====================

    // Handling når vi trykker på Edit-knappen. Fjerner feilmeldinger og resetter modell
    private void StartEdit()
    {
        _alert = null;
        ResetEditModel();
        _isEditing = true;
    }

    // Handling når vi avbryter redigering - Resetter modellene og fjerner redigeringsmodus
    private void CancelEdit()
    {
        ResetEditModel();
        _isEditing = false;
    }

    // Resetter redigeringsmodellen og editcontexten
    private void ResetEditModel()
    {
        _editModel = DocumentEditModel.FromDto(_document!);
        _editContext = new EditContext(_editModel);
    }

    // Handling som utføres når vi trykker på lagring - Bygger en request og utfører kall til backend
    private async Task SaveEdit()
    {
        if (HasInactiveDepartments)
        {
            _alert = new AlertInfo("Fjern inaktive avdelinger fra målgruppen før du lagrer.", Severity.Error);
            return;
        }

        if (HasInactiveJobTitles)
        {
            _alert = new AlertInfo("Fjern inaktive stillinger fra målgruppen før du lagrer.", Severity.Error);
            return;
        }

        var request = _editModel.ToRequest();

        var updateResult = await DocumentService.UpdateAsync(Slug, Id, request, Cts.Token);
        if (updateResult.IsFailure)
        {
            _alert = new AlertInfo(updateResult.Error!.ToString(), Severity.Error);
            return;
        }

        if (_document!.RequiresSignature)
            await RefreshSignaturesAsync();

        // Resetter feltene kun hvis det var vellykket
        _document = updateResult.Value;
        ResetEditModel();
        _isEditing = false;
        _alert = new AlertInfo("Dokumentet ble oppdatert", Severity.Success);
    }

    // Viser en dialog som brukeren må godkjenne for å kunne slette entiteten. Navigerer til List-siden hvis vellykket
    private async Task Delete()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDeleteDialog.Title), "Slett dokumentet" },
            { nameof(ConfirmDeleteDialog.Message), $"Er du sikker på at du ønsker å slette {_document!.Title}?" },
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        var deleteResult = await DocumentService.DeleteAsync(Slug, Id, Cts.Token);
        if (deleteResult.IsFailure)
        {
            _alert = new AlertInfo(deleteResult.Error!.ToString(), Severity.Error);
            return;
        }

        // TODO: Hvordan kan vi navigere hitt? Da må vi ha Slug og navnet til Slug... Kanskje sendees med DocumentDto?
        NavigationManager.NavigateTo(PageRoutes.Documents.List(_document.DocumentTypeSlug, _documentType!.Name) 
                                     + "?deleted=true");
    }

    // Viser en dialog for å opprette en kategori
    private async Task UpdateDocumentVersion()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(UpdateDocumentVersionDialog.Slug), Slug },
            { nameof(UpdateDocumentVersionDialog.DocumentId), _document!.Id },
            { nameof(UpdateDocumentVersionDialog.Title), _document!.Title },
            { nameof(UpdateDocumentVersionDialog.MaxFileSizeInBytes), _documentType!.MaxFileSizeBytes },
            { nameof(UpdateDocumentVersionDialog.AcceptedMimeTypes), string.Join(',', _documentType.AllowedMimeTypes) },
            { nameof(UpdateDocumentVersionDialog.CurrentFile), _document!.ToFileInfo() }
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<UpdateDocumentVersionDialog>("", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        if (dialogResult.Data is not DocumentDto updatedDocument)
        {
            _alert = new AlertInfo("Noe gikk galt ved opplasting av ny versjon.", Severity.Error);
            return;
        }

        _document = updatedDocument;
        _alert = new AlertInfo($"Versjon {updatedDocument.Version} lastet opp", Severity.Success);
    }
    
    private async Task SignDocument()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(SignDocumentDialog.Slug), Slug },
            { nameof(SignDocumentDialog.DocumentId), _document!.Id },
            { nameof(SignDocumentDialog.Title), _document!.Title },
            { nameof(SignDocumentDialog.HasFile), _document!.HasFile },
            { nameof(SignDocumentDialog.MimeType), _document!.MimeType },
        };
        
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<SignDocumentDialog>("", parameters, options);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        if (dialogResult.Data is not bool isSigned)
        {
            _alert = new AlertInfo("Noe gikk galt ved singering.", Severity.Error);
            return;
        }

        if (isSigned)
            await RefreshSignaturesAsync();
    }

    private async Task RefreshSignaturesAsync()
    {
        var signatureResult = await SignatureService.GetSignaturesAsync(Slug, Id, Cts.Token);
        if (signatureResult.IsFailure)
        {
            _alert = new AlertInfo(signatureResult.Error!.ToString(), Severity.Error);
            return;
        }
       
        _signatures = signatureResult.Value!;
        _alert = new AlertInfo("Dokumentet ble signert", Severity.Success); 
    }

    // Sjekker om det er noen inaktive entiteter blandt de valgte målgruppene
    private bool HasInactiveDepartments =>
        (_isEditing ? _editModel.TargetDepartmentIds : _document!.TargetDepartmentIds)
        .Any(id => _departments.Any(d => d.Id == id && !d.IsActive));

    private bool HasInactiveJobTitles =>
        (_isEditing ? _editModel.TargetJobTitleIds : _document!.TargetJobTitleIds)
        .Any(id => _jobTitles.Any(j => j.Id == id && !j.IsActive));

    private void NavigateToExternalUrl()
    {
        if (!string.IsNullOrWhiteSpace(_document?.ExternalUrl))
            NavigationManager.NavigateTo(_document.ExternalUrl, forceLoad: true);
    }

}