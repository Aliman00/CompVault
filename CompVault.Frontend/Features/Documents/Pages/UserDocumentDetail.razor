@page "/my-documents/{Slug}/{Id:guid}"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject ISignatureService SignatureService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject CircuitUserContext CircuitUser
@inject IJSRuntime Js

@* Readonly detaljside for innlogget bruker – viser ett dokument *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else if (_document != null)
{
    <MudPaper Class="pa-6" Elevation="1" Square="true">

        @* Header *@
        <section class="detail-header">
            <header class="detail-header-text">
                <MudText Typo="Typo.h5">@_document.Title.Truncate(45)</MudText>
                @if (!string.IsNullOrWhiteSpace(_document.CategoryName))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_document.CategoryName.Truncate(100)</MudText>
                }
            </header>

            @* Signeringsknapp i header hvis dokumentet krever signatur og brukeren ikke har signert *@
            @if (_document.RequiresSignature && _mustSign && !_hasSigned)
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Draw"
                           OnClick="SignDocument">
                    Signer dokumentet
                </MudButton>
            }
        </section>

        @* Signeringsstatus-alert under headeren *@
        @if (_document.RequiresSignature && _mustSign)
        {
            <DocumentSignatureStatusAlert CurrentUserMustSign="_mustSign"
                                          CurrentUserHasSigned="_hasSigned"
                                          SignatureVersion="_currentUserSignature?.SignatureVersion"
                                          DocumentVersion="_document.Version"/>
        }

        @* Felter *@
        <MudGrid>

            @* Tittel *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_document.Title"
                           Label="Tittel"
                           IsEditing="false"/>
            </MudItem>

            @* Kategori *@
            @if (!string.IsNullOrWhiteSpace(_document.CategoryName))
            {
                <MudItem xs="12" sm="6">
                    <TextField Value="@_document.CategoryName"
                               Label="Kategori"
                               IsEditing="false"/>
                </MudItem>
            }

            @* Versjon *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_document.Version.ToString()"
                           Label="Versjon"
                           IsEditing="false"/>
            </MudItem>

            @* Lastet opp *@
            <MudItem xs="12" sm="6">
                <TextField Value="@(_document.UploadedAt.ToString("dd.MM.yyyy"))"
                           Label="Lastet opp"
                           IsEditing="false"/>
            </MudItem>

            @* Lastet opp av *@
            @if (!string.IsNullOrWhiteSpace(_document.UploadedByName))
            {
                <MudItem xs="12" sm="6">
                    <TextField Value="@_document.UploadedByName"
                               Label="Lastet opp av"
                               IsEditing="false"/>
                </MudItem>
            }

            @* Beskrivelse *@
            @if (!string.IsNullOrWhiteSpace(_document.Description))
            {
                <MudItem xs="12">
                    <TextField Value="@_document.Description"
                               Label="Beskrivelse"
                               IsEditing="false"
                               Lines="4"/>
                </MudItem>
            }

            @* Signering *@
            @if (_document.RequiresSignature)
            {
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Signering</MudText>
                        <div style="width: fit-content">
                            @if (_hasSigned)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Medium" Class="cv-rounded">
                                    Signert
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Medium" Class="cv-rounded">
                                    Venter signering
                                </MudChip>
                            }
                        </div>
                    </MudStack>
                </MudItem>
            }

            @* Ekstern URL *@
            @if (!string.IsNullOrWhiteSpace(_document.ExternalUrl))
            {
                <MudItem xs="12" sm="6">
                    <TextField Value="@_document.ExternalUrl"
                               Label="Ekstern lenke"
                               IsEditing="false"
                               ShowLink="true"
                               OnAdornmentClick="() => NavigationManager.NavigateTo(_document.ExternalUrl, forceLoad: true)"/>
                </MudItem>
            }

            @* Fil *@
            @if (_document.HasFile)
            {
                <MudItem xs="12" sm="6">
                    <DocumentFileCard DocumentFileRecord="_document.ToFileInfo()!"/>
                </MudItem>
            }

        </MudGrid>
    </MudPaper>
}

@code {

    // ===================== PARAMETER =====================
    [Parameter, EditorRequired] public Guid Id { get; set; }
    
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;

    // ===================== PRIVATE FELT =====================
    private DocumentDto? _document;
    private List<UserSignatureStatusDto> _signatures = [];
    
    private UserSignatureStatusDto? _currentUserSignature =>
        _signatures.FirstOrDefault(s => s.UserId == CircuitUser.UserId);

    private bool _mustSign => _currentUserSignature != null;
    private bool _hasSigned => _currentUserSignature?.HasSigned == true;
    
    private bool _isLoading = true;
    private AlertInfo? _alert;

    // ===================== LIFECYCLE =====================
    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _signatures = [];

        try
        {
            var documentTask = DocumentService.GetByIdAsync(Slug, Id, Cts.Token);
            var signaturesTask = SignatureService.GetSignaturesAsync(Slug, Id, Cts.Token);

            await Task.WhenAll(documentTask, signaturesTask);

            var documentResult = await documentTask;
            if (documentResult.IsFailure)
            {
                _alert = new AlertInfo(documentResult.Error!.ToString(), Severity.Error);
                return;
            }
            
            _document = documentResult.Value;

            var signaturesResult = await signaturesTask;
            if (signaturesResult.IsFailure)
                _alert = new AlertInfo(signaturesResult.Error!.ToString(), Severity.Error);
            else
                _signatures = signaturesResult.Value!;
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste dokumentet. Oppdater siden for å prøve igjen.",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ===================== PRIVATE METHODS =====================
    
    private async Task SignDocument()
    {
        var parameters = new DialogParameters
        {
            { nameof(SignDocumentDialog.Slug), Slug },
            { nameof(SignDocumentDialog.DocumentId), _document!.Id },
            { nameof(SignDocumentDialog.Title), _document!.Title },
            { nameof(SignDocumentDialog.HasFile), _document!.HasFile },
            { nameof(SignDocumentDialog.MimeType), _document!.MimeType },
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SignDocumentDialog>("", parameters, options);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        if (dialogResult.Data is not bool isSigned || !isSigned)
        {
            _alert = new AlertInfo("Noe gikk galt ved signering.", Severity.Error);
            return;
        }

        // Oppdater signaturer etter vellykket signering
        var signaturesResult = await SignatureService.GetSignaturesAsync(Slug, Id, Cts.Token);
        if (signaturesResult.IsFailure)
        {
            _alert = new AlertInfo(signaturesResult.Error!.ToString(), Severity.Error);
            return;
        }

        _signatures = signaturesResult.Value!;
        _alert = new AlertInfo("Dokumentet ble signert", Severity.Success);
    }
}
