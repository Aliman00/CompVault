@page "/my-documents"
@attribute [Authorize]
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@inject IDocumentTypeService DocumentTypeService
@inject NavigationManager NavigationManager

@* Dokumentoversikt side med kategorivisning for videre navigering til dokumenter *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else
{   
    @* Header *@
    <MudPaper Elevation="1" Square="true" Class="p-2 mt-4">
        <MudToolBar Dense="true">
            <MudIcon Icon="@Icons.Material.Filled.Article" Class="mr-2" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">Dokument kategorier</MudText>
            <MudSpacer/>
        </MudToolBar>
        
        @* Liste med dokumenttypes/dokumentkategorier*@
        <MudList T="UserDocumentTypeDto" Dense="true" Class="pa-2">
            @if (!_documentTypes.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                    Du har ikke blitt tildelt noen dokumenter.
                </MudText>
            }
            @foreach (var documentType in _documentTypes)
            {
                <MudListItem T="UserDocumentTypeDto"
                             Class="cursor-pointer"
                             OnClick="@(() => NavigationManager.NavigateTo(
                                          PageRoutes.UserDocuments.List(documentType.Slug)))">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.Folder"
                                 Color="@(documentType.PendingSignatureCount > 0 ? Color.Warning : Color.Primary)"
                                 Size="Size.Medium"/>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">@documentType.Name</MudText>
                            @if (!string.IsNullOrWhiteSpace(documentType.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @documentType.Description.Truncate(60)
                                </MudText>
                            }
                        </MudStack>
                        <MudSpacer/>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @documentType.DocumentCount dokument@(documentType.DocumentCount == 1 ? "" : "er")
                            @if (documentType.PendingSignatureCount > 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Warning" Inline="true">
                                    (@documentType.PendingSignatureCount trenger signatur)
                                </MudText>
                            }
                        </MudText>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Secondary"/>
                    </MudStack>
                </MudListItem>
                <MudDivider/>
            }
        </MudList>
    </MudPaper>
}

@code {

    // ===================== PRIVATE FELT =====================
    private List<UserDocumentTypeDto> _documentTypes = [];

    private bool _isLoading = true;
    private AlertInfo? _alert;
    
    // ===================== LIFECYCLE =====================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await DocumentTypeService.GetMyDocumentTypesAsync(Cts.Token);

            if (result.IsFailure)
            {
                _alert = new AlertInfo(result.Error!.ToString(), Severity.Error);
                return;
            }

            _documentTypes = result.Value!;
        }
        catch (OperationCanceledException) { }
        catch
        {
            _alert = new AlertInfo(
                "Klarte ikke å laste dokumenttyper. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}