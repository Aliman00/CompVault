@page "/roles/create"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.RolesWrite)]
@inject IRoleService RoleService
@inject NavigationManager NavigationManager

@* Side for å opprette en avdeling *@
<CreateForm Title="Opprett rolle"
            EditContext="_editContext"
            OnValidSubmit="CreateRole"
            @bind-Alert="_alert">
    <Fields>
        @* Rollenavn *@
        <MudItem xs="12" sm="6">
            <TextField Value="@_editModel.Name"
                             ValueChanged="(string? v) => _editModel.Name = v ?? string.Empty"
                             Label="Rollenavn"
                             IsEditing="true"
                             For="() => _editModel.Name"/>
        </MudItem>
        @* Beskrivelse *@
        <MudItem xs="12" sm="6">
            <TextField Value="@_editModel.Description"
                             ValueChanged="(string? v) => _editModel.Description = v ?? string.Empty"
                             Label="Beskrivelse"
                             IsEditing="true"
                             For="() => _editModel.Description"
                             Lines="4"/>
        </MudItem>
    </Fields>
</CreateForm>



@code {
    // ===================== PRIVATE FELT =====================
    private readonly CreateRoleModel _editModel = new();

    private AlertInfo? _alert;

    private EditContext _editContext = null!;

    protected override Task OnInitializedAsync()
    {
        _editContext = new EditContext(_editModel);
        return Task.CompletedTask;
    }
    
    // ===================== PRIVATE METHODS =====================

    // Handlign som skjer når vi trykker på opprett-knappen. Utfører et API-kall og
    // navigerer oss til rollens side med created=true som et parameter
    private async Task CreateRole()
    {
        var request = _editModel.ToRequest();

        var createResult = await RoleService.CreateAsync(request, Cts.Token);
        if (createResult.IsFailure)
        {
            _alert = new AlertInfo(createResult.Error!.ToString(), Severity.Error);
            return;
        }

        NavigationManager.NavigateTo(PageRoutes.Roles.Detail(createResult.Value!.Id) + "?created=true",
            replace: true);
    }
}
