@page "/roles"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.RolesRead)]
@inject IRoleService RoleService
@inject NavigationManager NavigationManager

@* Side for liste visning av alle roller *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else
{
    @* Headeren til listen - Inneholder knappene for å utføre handlinger på en eller flere roller *@
    <ListHeader Title="Roller"
                CreateHref="@PageRoutes.Roles.RoleCreate"
                CreateLabel="Opprett rolle"
                CreateIcon="@Icons.Material.Filled.Shield"
                CreatePolicy="@Permissions.RolesWrite"/>

    @* Grid med liste over roller *@
    <MudDataGrid Items="_roles"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Square="true"
                 Bordered="true"
                 SortMode="SortMode.Multiple"
                 FixedHeader="true"
                 Loading="_isLoading"
                 MultiSelection="true"
                 @bind-SelectedItems="_selectedRoles"
                 RowClick="@((DataGridRowClickEventArgs<RoleDto> args) => OnRoleClick(args))">

        @* Selve kolonnene *@
        <Columns>
            <SelectColumn T="RoleDto"/>
            
            <PropertyColumn Property="roleDto => roleDto.Name.Truncate(30)" Title="Rollenavn"/>
            
            <PropertyColumn Property="roleDto => roleDto.Description"Title="Beskrivelse" Sortable="true">
                <CellTemplate>
                    @context.Item.Description.Truncate(30)
                </CellTemplate>
            </PropertyColumn>
            
            <PropertyColumn Property="roleDto => roleDto.UserCount" 
                            Title="Tildelte brukere"
                            Filterable="false"
                            HeaderStyle="width: 60px;"/>
            
            <TemplateColumn Title="Låst" 
                            Sortable="true" 
                            SortBy="@(roleDto => roleDto.IsSystem)"
                            HeaderStyle="width: 120px;">
                <CellTemplate>
                    @if (context.Item.IsSystem)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small" 
                                 Title="Systemrolle"/> 
                    }
                </CellTemplate>
            </TemplateColumn>
            
        </Columns>
    </MudDataGrid>
}


@code {

    // ===================== PARAMETER =====================
    [SupplyParameterFromQuery(Name = "deleted")] // Ved sletting av en rolle
    public bool Deleted { get; set; }

    // ===================== PRIVATE FELT =====================
    private List<RoleDto> _roles = [];
    private HashSet<RoleDto> _selectedRoles = [];

    private bool _isLoading = true;
    private AlertInfo? _alert;

    // ===================== LIFECYCLE =====================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var getRolesResult = await RoleService.GetAllAsync(Cts.Token);

            if (getRolesResult.IsFailure)
            {
                _alert = new AlertInfo(getRolesResult.Error!.ToString(), Severity.Error);
                return;
            }

            _roles = getRolesResult.Value!;

            if (Deleted)
                _alert = new AlertInfo("Rollen er slettet", Severity.Info);
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste roller. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ===================== PRIVATE METHODS =====================

    private void OnRoleClick(DataGridRowClickEventArgs<RoleDto> args) =>
        NavigationManager.NavigateTo(PageRoutes.Roles.RoleDetail(args.Item.Id));


}