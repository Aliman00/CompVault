@page "/roles/{Id:guid}"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.RolesRead)]
@inject IUserService UserService
@inject IRoleService RoleService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

@* Detalje visning av en avdeling med mulighet for oppdatering *@

<AppAlert @bind-Alert="_successAlert"/>
<AppAlert @bind-Alert="_errorAlert"/>
<AppAlert @bind-Alert="_usersAlert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else if (_role != null)
{
    @* SkjemaForm med validering med DataAnnotations *@
    <EditForm EditContext="_editContext" OnValidSubmit="SaveEdit">
        <DataAnnotationsValidator/>

        @* Header med navn og tittel, redigeringsknapper og dropdown meny for flere valg*@
        <MudPaper Class="pa-6" Elevation="1" Square="true">
            <DetailHeader Title="@_role.Name"
                          EditPolicy="@Permissions.RolesWrite"
                          Subtitle="@_role.Description"
                          IsEditing="_isEditing"
                          OnStartEdit="StartEdit"
                          OnCancelEdit="CancelEdit">
                @* Tilknytt tilattelse knapp *@
                <ExtraActions>
                    <ResponsiveButton Label="Permissions"
                                      Icon="@Icons.Material.Filled.Security"
                                      OnClick="OpenPermissionsDialog" />
                    
                </ExtraActions>
                @* Dropdown meny er disabled hvis brukeren ikke har korrekt tilattelse *@
                <DropdownActions>
                    <AuthorizeView Policy="@Permissions.RolesDelete" Context="auth">
                        <Authorized>
                            @if (_role.IsSystem)
                            {
                                <MudTooltip Text="Systemroller kan ikke slettes">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                 IconColor="Color.Default"
                                                 Disabled="true">
                                        <MudText>Slett rolle</MudText>
                                    </MudMenuItem>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                             IconColor="Color.Error"
                                             OnClick="Delete">
                                    <MudText Color="Color.Error">Slett rolle</MudText>
                                </MudMenuItem>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <MudTooltip Text="Du har ikke tilgang til å slette avdelingen">
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                             IconColor="Color.Default"
                                             Disabled="true">
                                    <MudText>Slett rolle</MudText>
                                </MudMenuItem>
                            </MudTooltip>
                        </NotAuthorized>
                    </AuthorizeView>
                </DropdownActions>
            </DetailHeader>

            @* Alle felt med egenskaper fra RoleDto *@
            <MudGrid>
                @* Rollenavn *@
                <MudItem xs="12" sm="6">
                    <DetailTextField Value="@_editModel.Name"
                                     ValueChanged="(string? v) => _editModel.Name = v ?? string.Empty"
                                     Label="Rollenavn"
                                     IsEditing="_isEditing"
                                     For="() => _editModel.Name"/>
                </MudItem>
                
                @* Beskrivelse *@
                <MudItem xs="12" sm="6">
                    <DetailTextField Value="@_editModel.Description"
                                     ValueChanged="(string? v) => _editModel.Description = v ?? string.Empty"
                                     Label="Beskrivelse (valgfritt)"
                                     IsEditing="_isEditing"
                                     For="() => _editModel.Description"/>
                </MudItem>
              

                @* Opprettelsesdato *@
                <MudItem xs="12" sm="6">
                    <DetailTextField Value="@_role.CreatedAt.ToString(CultureInfo.InvariantCulture)"
                                     Label="Opprettet"
                                     IsEditing="false"/>

                </MudItem>

                @* Brukeren som opprettet *@
                <MudItem xs="12" sm="6">
                    <DetailTextField Value="@_role.CreatedByName"
                                     Label="Opprettet av bruker"
                                     IsEditing="false"
                                     ShowLink="_role.CreatedById.HasValue"
                                     OnAdornmentClick="NavigateToCreatedByUser"
                                     HelperText="@(HasCreatedByUser ? "Trykk for å gå til brukeren" : null)"/>

                </MudItem>
                
                @* Brukere med denne rollen *@
                <MudItem xs="12">
                    <UserTable Title="@($"Brukere tildelt denne rollen ({_role.UserCount})")"
                               EmptyText="Ingen brukere tildelt denne rollen."
                               Users="_usersWithRole"
                               OnUserClick="NavigateToUser"/>
                </MudItem>
                
            </MudGrid>
        </MudPaper>
    </EditForm>
}

@code {

    // ===================== PARAMETER =====================
    [Parameter, EditorRequired] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "created")] // Optional parameter ved vellykket oppretting av en avdeling
    public bool Created { get; set; }

    // ===================== PRIVATE FELT =====================
    private RoleDto? _role;
    private List<UserDto> _usersWithRole = [];

    private RoleEditModel _editModel = new();

    private bool _isLoading = true;

    // Forskjellige feilmeldinger for forkjellige beskjeder
    private AlertInfo? _errorAlert;
    private AlertInfo? _usersAlert;
    private AlertInfo? _successAlert;

    private EditContext _editContext = null!;

    private bool _isEditing; // Bool som bytter feltene mellom lese-modus og redigeringsmodus
    
    private bool HasCreatedByUser => _role?.CreatedById.HasValue == true;

    // ===================== LIFECYCLE =====================
    protected override async Task OnParametersSetAsync()
    {
        // Resetter alle feltene ved oppdatering/navigering til siden
        _isLoading = true;
        _isEditing = false;
        _usersWithRole = [];
        _editModel = new();

        try
        {
            _editContext = new EditContext(_editModel);
            
            // TODO: Permissions her

            // Henter rollen og brukere for å vise en oversikt over brukere tildelt rollen - Kalles parallelt
            var roleTask = RoleService.GetByIdAsync(Id, Cts.Token);
            var usersTask = UserService.GetAllAsync(Cts.Token);

            await Task.WhenAll(roleTask, usersTask);

            var roleResult = await roleTask;
            var usersResult = await usersTask;

            if (roleResult.IsFailure)
            {
                _errorAlert = new AlertInfo(roleResult.Error!.ToString(), Severity.Error);
                return;
            }

            _role = roleResult.Value;
            if (_role == null) // Rollen kan være null ved feil Guid
            {
                _errorAlert = new AlertInfo("Fant ikke brukeren", Severity.Error);
                return;
            }

            if (usersResult.IsFailure)
                _usersAlert = new AlertInfo(usersResult.Error!.ToString(), Severity.Error);
            else
                _usersWithRole = usersResult.Value!.Where(u => u.Roles.Contains(_role.Name)).ToList();

            ResetEditModel();
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _errorAlert = new AlertInfo("Klarte ikke å laste rollen. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;

            if (Created)
                _successAlert = new AlertInfo("Rollen ble opprettet", Severity.Success);
        }
    }

    // ===================== PRIVATE METHODS =====================

    // Handling når vi trykker på Edit-knappen. Fjerner feilmeldinger og resetter modell
    private void StartEdit()
    {
        _errorAlert = null;
        _usersAlert = null;
        _successAlert = null;
        ResetEditModel();
        _isEditing = true;
    }

    // Handling når vi avbryter redigering - Resetter modellene og fjerner redigeringsmodus
    private void CancelEdit()
    {
        ResetEditModel();
        _isEditing = false;
    }

    // Resetter redigeringsmodellen og editcontexten
    private void ResetEditModel()
    {
        _editModel = RoleEditModel.FromDto(_role!);
        _editContext = new EditContext(_editModel);
    }

    // Handling som utføres når vi trykker på lagring - Bygger en request og utfører kall til backend
    private async Task SaveEdit()
    {
        var request = _editModel.ToRequest();

        var updateResult = await RoleService.UpdateAsync(Id, request, Cts.Token);
        if (updateResult.IsFailure)
        {
            _errorAlert = new AlertInfo(updateResult.Error!.ToString(), Severity.Error);
            return;
        }

        // Resetter feltene kun hvis det var vellykket
        _role = updateResult.Value;
        ResetEditModel();
        _isEditing = false;
        _successAlert = new AlertInfo("Rollen ble oppdatert", Severity.Success);
    }
    
    private void NavigateToCreatedByUser()
    {
        if (_role?.CreatedById.HasValue == true)
            NavigationManager.NavigateTo(PageRoutes.Users.UserDetail(_role.CreatedById!.Value));
    }
    
    private void NavigateToUser(Guid userId) =>
        NavigationManager.NavigateTo(PageRoutes.Users.UserDetail(userId));

    // Viser en dialog som brukeren må godkjenne for å kunne slette entiteten. Navigerer til List-siden hivs vellykket
    private async Task Delete()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDeleteDialog.Title), "Slett rollen" },
            { nameof(ConfirmDeleteDialog.Message), $"Er du sikker på at du ønsker å slette {_role!.Name}?" },
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        var updateResult = await RoleService.DeleteAsync(Id, Cts.Token);
        if (updateResult.IsFailure)
        {
            _errorAlert = new AlertInfo(updateResult.Error!.ToString(), Severity.Error);
            return;
        }

        NavigationManager.NavigateTo(PageRoutes.Roles.RoleList + "?deleted=true");
    }
    
    // Viser en dialog som brukeren kan knytte tilattelser til rollen
    private async Task OpenPermissionsDialog()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(PermissionDialog.RoleId), Id },
            { nameof(PermissionDialog.CurrentPermissions), _role!.Permissions },
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<PermissionDialog>("", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        if (dialogResult.Data is not RoleDto updatedRole)
        {
            _errorAlert = new AlertInfo("Noe gikk galt ved oppdatering av permissions.", Severity.Error);
            return;
        }
        
        _role = updatedRole;
        _successAlert = new AlertInfo("Permissions oppdatert", Severity.Success);
    }

}