@page "/competency-types/create"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.CompetenciesWrite)]
@inject ICompetencyTypeService CompetencyTypeService
@inject NavigationManager NavigationManager

@* Side for å opprette en kompetansetype *@

<CreateForm Title="Opprett kompetansetype"
            EditContext="_editContext"
            OnValidSubmit="CreateCompetencyType"
            @bind-Alert="_alert">
    <Fields>
        @* Navn *@
        <MudItem xs="12" sm="6">
            <TextField Value="@_editModel.Name"
                             ValueChanged="(string? v) => _editModel.Name = v ?? string.Empty"
                             Label="Navn"
                             IsEditing="true"
                             For="() => _editModel.Name"/>
        </MudItem>
        @* Kategori *@
        <MudItem xs="12" sm="6">
            <TextField Value="@_editModel.Category"
                             ValueChanged="(string? v) => _editModel.Category = v ?? string.Empty"
                             Label="Kategori (valgfritt)"
                             IsEditing="true"
                             For="() => _editModel.Category"/>
        </MudItem>
        @* Beskrivelse *@
        <MudItem xs="12">
            <TextField Value="@_editModel.Description"
                             ValueChanged="(string? v) => _editModel.Description = v ?? string.Empty"
                             Label="Beskrivelse (valgfritt)"
                             IsEditing="true"
                             For="() => _editModel.Description"
                             Lines="4"/>
        </MudItem>
        @* Utløpsdato *@
        <MudItem xs="12">
            <ToggleButton Label="Skal kompetansebevisene utgå?"
                          @bind-Value="_editModel.RequiresExpiration"
                          IsEditing="true">
                <MudToggleItem Value="(bool?)true" Text="Krever utløpsdato"/>
                <MudToggleItem Value="(bool?)false" Text="Ingen utløpsdato"/>
            </ToggleButton>
        </MudItem>
    </Fields>
</CreateForm>

@code {
    // ===================== PRIVATE FELT =====================
    private readonly CreateCompetencyTypeModel _editModel = new();

    private AlertInfo? _alert;

    private EditContext _editContext = null!;

    protected override Task OnInitializedAsync()
    {
        _editContext = new EditContext(_editModel);
        return Task.CompletedTask;
    }
    
    // ===================== PRIVATE METHODS =====================

    // Handlign som skjer når vi trykker på opprett-knappen. Utfører et API-kall og
    // navigerer oss til kompetansebevistypen
    private async Task CreateCompetencyType()
    {
        var request = _editModel.ToRequest();

        var createResult = await CompetencyTypeService.CreateAsync(request, Cts.Token);
        if (createResult.IsFailure)
        {
            _alert = new AlertInfo(createResult.Error!.ToString(), Severity.Error);
            return;
        }

        NavigationManager.NavigateTo(
            PageRoutes.CompetencyTypes.Detail(createResult.Value!.Id) + "?created=true");
    }
}
