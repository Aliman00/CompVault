@page "/competencies/{Id:guid}"
@using CompVault.Frontend.Features.Competencies.Components
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.CompetenciesRead)]
@attribute [Authorize(Policy = Permissions.AdminAccess)]
@inject ICompetencyService CompetencyService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

@* Detalje visning av en kompetansebevis med mulighet for oppdatering *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else if (_competency != null)
{
    <DetailForm Title="@_competency.ToDetailTitle()"
                Subtitle="@_competency.ToDetailSubtitle()"
                EditPolicy="@Permissions.CompetenciesWrite"
                EditContext="_editContext"
                OnValidSubmit="SaveEdit"
                IsEditing="_isEditing"
                OnStartEdit="StartEdit"
                OnCancelEdit="CancelEdit">
        <DropdownActions>
            <AuthorizeView Policy="@Permissions.CompetenciesDelete">
                <Authorized>
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                 IconColor="Color.Error"
                                 OnClick="Delete">
                        <MudText Color="Color.Error">Slett ansattkompetanse</MudText>
                    </MudMenuItem>
                    @if (_competency.Status != CompetencyStatus.Revoked)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Warning"
                                     OnClick="Revoke">
                            <MudText Color="Color.Warning">Tilbakekall ansattkompetanse</MudText>
                        </MudMenuItem>
                    }
                </Authorized>
                <NotAuthorized>
                    <MudTooltip Text="Du har ikke tilgang til å slette ansattkompetansen">
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                     IconColor="Color.Default"
                                     Disabled="true">
                            <MudText>Slett kompetansebevis</MudText>
                        </MudMenuItem>
                    </MudTooltip>
                    @if (_competency.Status != CompetencyStatus.Revoked)
                    {
                        <MudTooltip Text="Du har ikke tilgang til å tilbakekalle ansattkompetansen">
                            <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                         IconColor="Color.Default"
                                         Disabled="true">
                                <MudText>Tilbakekall kompetansebevis</MudText>
                            </MudMenuItem>
                        </MudTooltip>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </DropdownActions>
        <Fields>
           
            @* Brukeren *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_competency!.FullName"
                                 Label="Bruker"
                                 IsEditing="false"
                                 ShowLink="true"
                                 OnAdornmentClick="NavigateToUser"
                                 HelperText="Trykk for å gå til brukeren"/>
            </MudItem>

            @* Kompetansetype *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_competency!.CompetencyTypeName"
                                 Label="Kurstype"
                                 IsEditing="false"
                                 ShowLink="true"
                                 OnAdornmentClick="NavigateToCompetencyType"
                                 HelperText="Trykk for å gå til kompetansetypen"/>
            </MudItem>
            
            @* Utstedtdato *@
            <MudItem xs="12" sm="6">
                @if (!_isEditing)
                {
                    <TextField Value="@(_competency!.IssuedDate.ToString("dd.MM.yyyy"))"
                                     Label="Utstedt"
                                     IsEditing="false"/>
                }
                else
                {
                    <MudDatePicker @bind-Date="_editModel.IssuedDate"
                                   Label="Utstedt"
                                   DateFormat="dd.MM.yyyy"
                                   Required="true"
                                   RequiredError="Utsteddato er påkrevd" />
                }
            </MudItem>
            
            @* Utløpsdato *@
            @if (_competency.CompetencyTypeRequiresExpiration)
            {   
                <MudItem xs="12" sm="6">
                @if (!_isEditing)
                {
                        <TextField Value="@(_competency!.ExpiryDate?.ToString("dd.MM.yyyy") 
                                                  ?? string.Empty)"
                                         Label="Utløpsdato"
                                         IsEditing="false"/>
                    
                }
                else
                {
                        <MudDatePicker @bind-Date="_editModel.ExpiryDate"
                                       Label="Utløpsdato"
                                       DateFormat="dd.MM.yyyy"
                                       Required="true"
                                       RequiredError="Utløpsdato er påkrevd for denne kompetansetypen" />
                }
                </MudItem>
            }

            @* CertificateNumber *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_editModel.CertificateNumber"
                                 ValueChanged="(string? v) => _editModel.CertificateNumber = v ?? string.Empty"
                                 Label="Sertifikatnummer (valgfritt)"
                                 IsEditing="_isEditing"
                                 For="() => _editModel.CertificateNumber"/>
            </MudItem>

            @* Opprettet *@
            <MudItem xs="12" sm="6">
                <TextField Value="@(_competency!.CreatedAt.ToString("dd.MM.yyyy"))"
                                 Label="Opprettet"
                                 IsEditing="false"/>
            </MudItem>
            
            @* Notat *@
            <MudItem xs="12">
                <TextField Value="@_editModel.Notes"
                                 ValueChanged="(string? v) => _editModel.Notes = v ?? string.Empty"
                                 Label=@(_isEditing ? $"Notat (valgfritt). Maks lengde: " +
                                                      $"{CompValidations.NotesMaxLength}" : "Notat")
                                 IsEditing="_isEditing"
                                 For="() => _editModel.Notes"
                                 Lines="4"/>
            </MudItem>
            
            @* Status *@
            <MudItem xs="12" sm="6">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                    <div class="cv-status">
                        <MudChip T="string"
                                 Color="@_competency.Status.ToStatusColor()"
                                 Size="Size.Medium"
                                 Class="cv-rounded">
                            @_competency.Status.ToDisplayString()
                        </MudChip>
                    </div>
                </MudStack>
            </MudItem>

            @* Årsak til revoking og dato tilbakekalt *@
            @if (_competency.Status == CompetencyStatus.Revoked)
            {
                <MudItem xs="12" sm="6">
                    <TextField Value="@_editModel.RevokedReason"
                                     Label="Årsak til tilbakekalling"
                                     IsEditing="false"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <TextField Value="@(_competency!.RevokedAt?.ToString("dd.MM.yyyy") ?? string.Empty)"
                                     Label="Tilbakekalt"
                                     IsEditing="false"/>
                </MudItem>
            }
        </Fields>
    </DetailForm>
}

@code {

    // ===================== PARAMETER =====================
    [Parameter, EditorRequired] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "created")] // Optional parameter ved vellykket oppretting av en kompetansebevis
    public bool Created { get; set; }

    // ===================== PRIVATE FIELDS =====================
    private CompetencyDto? _competency;

    private CompetencyEditModel _editModel = new();

    private bool _isLoading = true;

    private AlertInfo? _alert;

    private EditContext _editContext = null!;

    private bool _isEditing; // Bool som bytter feltene mellom lese-modus og redigeringsmodus

    // ===================== LIFECYCLE =====================
    protected override async Task OnParametersSetAsync()
    {
        // Resetter alle feltene ved oppdatering/navigering til siden
        _isLoading = true;
        _isEditing = false;
        _editModel = new();

        try
        {
            _editContext = new EditContext(_editModel);

            // Henter kompetansetypen og bevisene til denne typen
            var competencyResult = await CompetencyService.GetByIdAsync(Id, Cts.Token);
            if (competencyResult.IsFailure)
            {
                _alert = new AlertInfo(competencyResult.Error!.ToString(), Severity.Error);
                return;
            }

            _competency = competencyResult.Value;

            ResetEditModel();
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste kompetansetypen. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;

            if (Created)
                _alert = new AlertInfo("Kompetansetypen ble opprettet", Severity.Success);
        }
    }

    // ===================== PRIVATE METHODS =====================

    // Handling når vi trykker på Edit-knappen. Fjerner feilmeldinger og resetter modell
    private void StartEdit()
    {
        _alert = null;
        ResetEditModel();
        _isEditing = true;
    }

    // Handling når vi avbryter redigering - Resetter modellene og fjerner redigeringsmodus
    private void CancelEdit()
    {
        ResetEditModel();
        _isEditing = false;
    }

    // Resetter redigeringsmodellen og editcontexten
    private void ResetEditModel()
    {
        _editModel = CompetencyEditModel.FromDto(_competency!);
        _editContext = new EditContext(_editModel);
    }

    // Handling som utføres når vi trykker på lagring - Bygger en request og utfører kall til backend
    private async Task SaveEdit()
    {
        var request = _editModel.ToRequest();

        var updateResult = await CompetencyService.UpdateAsync(Id, request, Cts.Token);
        if (updateResult.IsFailure)
        {
            _alert = new AlertInfo(updateResult.Error!.ToString(), Severity.Error);
            return;
        }

        // Resetter feltene kun hvis det var vellykket
        _competency = updateResult.Value;
        ResetEditModel();
        _isEditing = false;
        _alert = new AlertInfo("Kompetansetypen ble oppdatert", Severity.Success);
    }

    private void NavigateToCompetencyType() =>
        NavigationManager.NavigateTo(PageRoutes.CompetencyTypes.Detail(_competency!.CompetencyTypeId));

    private void NavigateToUser() =>
        NavigationManager.NavigateTo(PageRoutes.Users.Detail(_competency!.UserId));


    // Viser en dialog som brukeren må godkjenne for å kunne slette entiteten. Navigerer til List-siden hviss vellykket
    private async Task Delete()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDeleteDialog.Title), "Slett kompetansebevis" },
            {
                nameof(ConfirmDeleteDialog.Message), $"Er du sikker på at du ønsker å slette ansattkompetansen til " +
                                                     $"{_competency!.UserFirstName} {_competency!.UserLastName}?"
            },
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        var deleteResult = await CompetencyService.DeleteAsync(Id, Cts.Token);
        if (deleteResult.IsFailure)
        {
            _alert = new AlertInfo(deleteResult.Error!.ToString(), Severity.Error);
            return;
        }

        NavigationManager.NavigateTo(PageRoutes.Competencies.List + "?deleted=true");
    }
    
    private async Task Revoke()
    {
        // Oppretter parameterne for dialogen
        var parameters = new DialogParameters
        {
            { nameof(ConfirmRevokeDialog.Id), Id },
            {  nameof(ConfirmRevokeDialog.Message), 
                $"Er du sikker på at du ønsker å tilbakekalle ansattkompetansen " +
                $"«{_competency!.CompetencyTypeName}» for {_competency!.FullName}?" }
        };

        // Kaller dialogen
        var dialog = await DialogService.ShowAsync<ConfirmRevokeDialog>("", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult!.Canceled)
            return;

        if (dialogResult.Data is not CompetencyDto updatedCompetencyDto)
        {
            _alert = new AlertInfo("Noe gikk galt ved tilbakekalling av ansattkompetansen.", Severity.Error);
            return;
        }
        
        _competency = updatedCompetencyDto;
        ResetEditModel();
        _alert = new AlertInfo("Kompetansebeviset er tilbakekalt", Severity.Warning);
    }

}