@using CompVault.Frontend.Features.Competencies.Extensions
@using CompVault.Frontend.Features.Competencies.Models
@using CompVault.Frontend.Features.Competencies.Services
@using CompVault.Shared.DTOs.Competencies
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@inject ICompetencyService CompetencyService
@inject NavigationManager NavigationManager

@* Kompetanse-fanen med visning av alle kompetansebevis for brukeren *@

<AppAlert @bind-Alert="_alert"/>

<ListHeader Title="@($"Kompetansebevis ({_totalCount})")"
            PageIcon="@Icons.Material.Filled.WorkspacePremium">
    <Actions>
        <AuthorizeView Policy="@Permissions.CompetenciesWrite">
            <Authorized>
                <ResponsiveButton Label="Legg til"
                                  Icon="@Icons.Material.Filled.Add"
                                  OnClick="NavigateToCreate"/>
            </Authorized>
        </AuthorizeView>
    </Actions>
</ListHeader>

<MudDataGrid T="CompetencyDto"
             @ref="_grid"
             ServerData="LoadServerData"
             Dense="true"
             Hover="true"
             Striped="true"
             Square="true"
             Bordered="true"
             RowClick="OnRowClick"
             RowsPerPage="10">
    <Columns>

        @* Kompetansetype *@
        <PropertyColumn T="CompetencyDto" TProperty="string?"
                        Property="x => x.CompetencyTypeName.Truncate(40)"
                        Title="Type"/>

        @* Status *@
        <TemplateColumn T="CompetencyDto" Title="Status" SortBy="x => x.Status" Sortable="true">
            <CellTemplate Context="cell">
                <MudChip T="string"
                         Color="@cell.Item.Status.ToStatusColor()"
                         Size="Size.Small"
                         Class="cv-rounded">
                    @cell.Item.Status.ToDisplayString()
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        @* Utløpsdato *@
        <TemplateColumn T="CompetencyDto" Title="Utløpsdato" SortBy="x => x.ExpiryDate" Sortable="true">
            <CellTemplate Context="cell">
                @if (cell.Item.ExpiryDate is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                }
                else
                {
                    <div>
                        <MudText Typo="Typo.body2">
                            @cell.Item.ExpiryDate.Value.ToString("dd.MM.yyyy")
                        </MudText>
                        <MudText Typo="Typo.caption"
                                 Color="@cell.Item.DaysUntilExpiry.ToExpiryColor(cell.Item.Status)">
                            @cell.Item.DaysUntilExpiry.ToExpiryText(cell.Item.Status)
                        </MudText>
                    </div>
                }
            </CellTemplate>
        </TemplateColumn>

        @* Utstedelsesdato *@
        <PropertyColumn T="CompetencyDto" TProperty="DateOnly"
                        Property="x => DateOnly.FromDateTime(x.IssuedDate)"
                        Title="Utstedt"
                        Format="dd.MM.yyyy"/>

    </Columns>
    <PagerContent>
        <MudDataGridPager T="CompetencyDto"
                          RowsPerPageString="Rader pr side:"
                          PageSizeOptions="new[] { 10, 20, 50 }"/>
    </PagerContent>
</MudDataGrid>

@code {

    // ===================== PARAMETER =====================

    /// <summary>
    /// Brukeren vi henter kompetansebevis for
    /// </summary>
    [Parameter, EditorRequired] public Guid UserId { get; set; }

    // ===================== PRIVATE FIELDS =====================
    private MudDataGrid<CompetencyDto> _grid = null!;
    private int _totalCount;
    private AlertInfo? _alert;

    // ===================== PRIVATE METHODS =====================
    private async Task<GridData<CompetencyDto>> LoadServerData(GridState<CompetencyDto> state, CancellationToken ct)
    {
        var filter = new CompetencyFilterRequest
        {
            Page = state.Page + 1,
            PageSize = state.PageSize,
            UserId = UserId
        };

        var result = await CompetencyService.GetAllAsync(filter, ct);

        if (result.IsFailure)
        {
            _alert = new AlertInfo(result.Error!.ToString(), Severity.Error);
            return new GridData<CompetencyDto>();
        }
        
        _totalCount = result.Value!.TotalCount;
        StateHasChanged();
        
        return new GridData<CompetencyDto>
        {
            Items = result.Value!.Items,
            TotalItems = result.Value!.TotalCount
        };
    }

    private void OnRowClick(DataGridRowClickEventArgs<CompetencyDto> args) =>
        NavigationManager.NavigateTo(PageRoutes.Competencies.Detail(args.Item.Id));
    
    private void NavigateToCreate() =>
        NavigationManager.NavigateTo(PageRoutes.Competencies.CreateForUser(UserId));
}