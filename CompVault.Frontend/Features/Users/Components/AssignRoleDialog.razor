@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@inject IRoleService RoleService
@inject IUserService UserService

@* Dialog for å legge til en rolle på en bruker *@
<MudDialog>

    @* Tittel *@
    <TitleContent>
        <MudText Typo="Typo.h6">Administrer roller</MudText>
    </TitleContent>

    @* Body til dialogen *@
    <DialogContent>
        <AppAlert @bind-Alert="_errorAlert"/>
        
        @if (_isLoading)
        {
            <AppSpinner Class="pa-20"/>
        }
        else
        {
            @* Søkefelt *@
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Placeholder="Søk etter roller..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mb-2"/>
            
            @* Roller i en liste *@
            @* TODO: Vise det dobbelt i en MudGrid hvis det blir en lang liste med roller? *@
            <MudList T="string" Dense="true">
                @if (FilteredRoles.Any())
                {
                    <MudList T="string" Dense="true">
                        @foreach (var role in FilteredRoles)
                        {
                            <MudListItem T="string" OnClick="() => ToggleRole(role.Name)">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body1">@role.Name</MudText>
                                    @if (!string.IsNullOrWhiteSpace(role.Description))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@role.Description</MudText>
                                    }
                                    @if (role.Permissions.Any())
                                    {
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            @foreach (var permission in role.Permissions.Take(4))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="border-radius: 4px;">
                                                    @permission.ToNorwegianPermission()
                                                </MudChip>
                                            }
                                            @if (role.Permissions.Count > 4)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="align-self: center">
                                                    +@(role.Permissions.Count - 4) til
                                                </MudText>
                                            }
                                        </MudStack>
                                    }
                                </MudStack>
                                <MudDivider/>
                            </MudListItem>
                        }
                    </MudList>
                }
                else
                {
                    @* Skal aldri skje, men en fallback hvis noe går galt eller vi fjerner seeding av roller *@
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Ingen roller funnet</MudText>
                }
            </MudList>
        }
    </DialogContent>

    

    @* Knapp for godkjenn handling og avbryt handling *@
    <DialogActions>
        <MudButton Variant="Variant.Outlined"
                   OnClick="Cancel">
            Avbryt
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Save"
                   Disabled="_isLoading || _isSaving">
            Lagre
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    // ===================== PARAMETER =====================
    /// <summary>
    /// Parameter som kreves av Mudblazor - settes når dialogen åpnes
    /// </summary>
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// Brukeren som vi administerer roller til
    /// </summary>
    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    /// <summary>
    /// Brukerens allerede eksisterende roller
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> CurrentRoles { get; set; } = [];

    // ===================== PRIVATE FIELDS =====================
    private List<RoleDto> _allRoles = [];
    

    // En liste som filtrere bort roller som ikke stemmer med søkestrengen
    private List<RoleDto> FilteredRoles =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _allRoles
            : _allRoles.Where(roleDto => roleDto.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
    
    // Søketekst for filtrering
    private string _searchText = string.Empty;
    
    // Lagrer kun navnene til de valgte listene
    private List<string> _selectedRoleNames= [];
    
    private bool _isLoading = true;
    private bool _isSaving;

    private AlertInfo? _errorAlert;

    
    // ===================== LIFECYCLE =====================
    // Henter alle roller fra backend og oppdaterer listen med allerede valgte roller
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _selectedRoleNames = CurrentRoles.ToList();

            var roleResult = await RoleService.GetAllAsync(Cts.Token);
            if (roleResult.IsFailure)
            {
                _errorAlert = new AlertInfo(roleResult.Error!.ToString(), Severity.Error);
                return;
            }

            _allRoles = roleResult.Value!;

        }
        finally
        {
            _isLoading = false;
        }
    }

    // ===================== PRIVATE METHODS =====================
    
    // Ved toggle så fjernes en rolle eller legges til i listen
    private void ToggleRole(string roleName)
    {
        if (_selectedRoleNames.Contains(roleName))
            _selectedRoleNames.Remove(roleName);
        else
            _selectedRoleNames.Add(roleName);
    }

    // Sender roller til backend og prøver å oppdatere brukeren. Lukkes ved vellyket lagring. Sender UserDto tilbake
    // til Detail-siden
    // TODO: Denne logikken kan ekstraheres ut i egent endepunkt slik at UpdateUser får mindre ansvar.
    // TODO: Derfor utfører vi bare UpdateUserRequest med kun Roles og ikke flere felter
    private async Task Save()
    {
        _isSaving = true;
        try
        {
            var request = new UpdateUserRequest
            {
                Roles = _selectedRoleNames
            };
            
            var assignRoleResult = await UserService.UpdateAsync(UserId, request, Cts.Token);
            if (assignRoleResult.IsFailure)
            {
                _errorAlert = new AlertInfo(assignRoleResult.Error!.ToString(), Severity.Error);
                return;
            }

            MudDialog.Close(DialogResult.Ok(assignRoleResult.Value));
        }
        finally
        {
            _isSaving = false;
        }
        
    }

    private void Cancel() => MudDialog.Cancel();
}