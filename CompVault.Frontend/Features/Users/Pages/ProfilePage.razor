@page "/profile"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@inject IUserService UserService

@* Detalje visning av en bruker med mulighet for oppdatering *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else if (_user != null)
{
    <MudPaper Class="pa-6" Elevation="1" Square="true">
        <section class="detail-header">
            <header class="detail-header-text">
                <MudText Typo="Typo.h5">Min profil</MudText>
                @if (!string.IsNullOrWhiteSpace(_user?.FullName))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_user!.FullName</MudText>
                }
            </header>
        </section>
        <MudGrid>
            @* Fornavn *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_user!.FirstName"
                           Label="Fornavn"
                           IsEditing="false"/>
            </MudItem>
            @* Etternavn *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_user!.LastName"
                           Label="Etternavn"
                           IsEditing="false"/>
            </MudItem>
            @* Email *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_user!.Email"
                           Label="Email"
                           IsEditing="false"/>
            </MudItem>
            @* Stillingstittel *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_user!.JobTitleName.DashIfEmpty()"
                           Label="Stillingstittel"
                           IsEditing="false"/>
            </MudItem>

            @* EmploymentType *@
            <MudItem xs="12" sm="6">
                <EnumField T="EmploymentType"
                           Value="@_user!.EmploymentType"
                           Label="Ansettelsestype"
                           IsEditing="false"/>
            </MudItem>
            @* Opprettelsesdato *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_user!.CreatedAt.ToString(CultureInfo.InvariantCulture)"
                           Label="Opprettet"
                           IsEditing="false"/>
            </MudItem>
            @* Avdeling *@
            @* Avdeling *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_user!.DepartmentName.DashIfEmpty()"
                           Label="Avdeling"
                           IsEditing="false"/>
            </MudItem>
            @* Nærmeste leder *@
            <MudItem xs="12" sm="6">
                <TextField Value="@_user!.ManagerName.DashIfEmpty()"
                           Label="Nærmeste leder"
                           IsEditing="false"/>
            </MudItem>

            @* Roller *@
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Roller</MudText>
                <MudStack Row="true" Spacing="0" Wrap="Wrap.Wrap">
                    @foreach (var role in _user!.Roles)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined"
                                 Class="cv-rounded">
                            @role.Truncate(50)
                        </MudChip>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {

    // ===================== PARAMETER =====================

    // ===================== PRIVATE FELT =====================
    private UserDto? _user;
    
    private bool _isLoading = true;

    // Forskjellige feilmeldinger for forkjellige beskjeder
    private AlertInfo? _alert;
    
    // ===================== LIFECYCLE =====================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userResult = await UserService.GetCurrentUserAsync(Cts.Token);
            if (userResult.IsFailure)
            {
                _alert = new AlertInfo(userResult.Error!.ToString(), Severity.Error);
                return;
            }
            _user = userResult.Value;
            if (_user == null)
                _alert = new AlertInfo("Fant ikke brukeren", Severity.Error);
        }
        catch (OperationCanceledException) { }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste brukeren. Oppdater siden for å prøve igjen", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}