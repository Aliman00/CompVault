@page "/admin/users/{Id:guid}"
@using CompVault.Shared.DTOs.Users
@inject NavigationManager NavigationManager
@implements IDisposable

<h3>UserDetail</h3>

@code {
    
    // ===================== PARAMETER =====================
    [Parameter]
    public Guid Id { get; set; }
    
    // ===================== PRIVATE FELT =====================
    private UserDto? _user;
    
    private bool _isLoading = true;
    private AlertInfo? _alert;
    
    private readonly CancellationTokenSource _cts = new();
    
    // ===================== LIFECYCLE =====================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Ved navigering fra UserList - hent UserDto fra nettleserens historikk
            string? deserializedUserDto = NavigationManager.HistoryEntryState;
            if (!string.IsNullOrEmpty(deserializedUserDto))
            {
                _user = JsonSerializer.Deserialize<UserDto>(deserializedUserDto);
                return;
            }
        
            // Ved navigering med URL eller refresh - hent UserDto fra backend
            var userResult = await UserService.GetByIdAsync(Id, _cts.Token):
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste brukeren. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}