@page "/users"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.UsersRead)]
@inject IUserService UserService
@inject NavigationManager NavigationManager

@* Side for liste visning av alle brukere *@

<AppAlert @bind-Alert="_alert"/>

@if (_isLoading)
{
    <AppSpinner Class="pa-20"/>
}
else
{
    @* Headeren til listen - Inneholder knappene for å utføre handlinger på en eller flere brukere *@
    @* For øyeblikket kun Rediger-bruker knapp som er disabled hvis bruker ikke har user:write tilgang*@
    <ListHeader Title="Brukere"
                CreateHref="@PageRoutes.Users.UserCreate"
                CreateLabel="Opprett bruker"
                CreateIcon="@Icons.Material.Filled.PersonAdd"
                CreatePolicy="@Permissions.UsersWrite"/>
    
    @* Grid med liste over brukere *@
    <MudDataGrid Items="_users"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Square="true"
                 Bordered="true"
                 SortMode="SortMode.Multiple"
                 FixedHeader="true"
                 Loading="_isLoading"
                 MultiSelection="true"
                 @bind-SelectedItems="_selectedUsers"
                 RowClick="@((DataGridRowClickEventArgs<UserDto> args) => OnUserClick(args))">

        @* Selve kolonnene *@
        <Columns>
            <SelectColumn T="UserDto"/>
            <PropertyColumn Property="x => x.FullName" Title="Navn"
                            SortBy="x => x.LastName" />
            <PropertyColumn Property="user => user.JobTitle" Title="Stillingstittel"/>
            <PropertyColumn Property="user => user.DepartmentName" Title="Avdeling"/>
            <PropertyColumn Property="user => user.ManagerName" Title="Nærmeste leder"/>
        </Columns>
    </MudDataGrid>
}




@code {
    // ===================== PARAMETER =====================
    [SupplyParameterFromQuery(Name = "deleted")] // Ved sletting av en bruker
    public bool Deleted { get; set; }
    
    // ===================== PRIVATE FELT =====================
    private List<UserDto> _users = [];
    private HashSet<UserDto> _selectedUsers = [];
    
    private bool _isLoading = true;
    private AlertInfo? _alert;
    
    // ===================== LIFECYCLE =====================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var getUsersResult = await UserService.GetAllAsync(Cts.Token);

            if (getUsersResult.IsFailure)
            {
                _alert = new AlertInfo(getUsersResult.Error!.ToString(), Severity.Error);
                return;
            }

            _users = getUsersResult.Value!;
            
            if (Deleted)
                _alert = new AlertInfo("Brukeren er slettet", Severity.Info);
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste brukere. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    // ===================== PRIVATE METHODS =====================
    
    // Navigerer ved å sende UserDto via NavigationManager (ikke via URL-en, men som en string i nettlesere)
    private void OnUserClick(DataGridRowClickEventArgs<UserDto> args) =>
        NavigationManager.NavigateTo(PageRoutes.Users.UserDetail(args.Item.Id));
    
}