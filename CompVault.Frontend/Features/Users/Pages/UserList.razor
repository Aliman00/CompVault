@page "/users"
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase
@attribute [Authorize(Policy = Permissions.UsersRead)]
@inject IUserService UserService
@inject NavigationManager NavigationManager

@* Side for liste visning av alle brukere *@
<ListPage TItem="UserDto"
          Items="_users"
          IsLoading="_isLoading"
          @bind-Alert="_alert"
          SelectedItemsChanged="@(s => _selectedUsers = s)"
          RowClick="@(args => OnUserClick(args))">
    <Header>
        <ListHeader Title="Brukere"
                    CreateHref="@PageRoutes.Users.Create"
                    CreateLabel="Opprett bruker"
                    CreateIcon="@Icons.Material.Filled.PersonAdd"
                    CreatePolicy="@Permissions.UsersWrite"/>
    </Header>
    <Columns>
        <PropertyColumn T="UserDto" TProperty="string"
                        Property="x => x.FullName.Truncate(40)" Title="Navn"
                        SortBy="x => x.LastName.Truncate(40)"/>
        <PropertyColumn T="UserDto" TProperty="string"
                        Property="user => user.JobTitle.Truncate(40)" Title="Stillingstittel"/>
        <PropertyColumn T="UserDto" TProperty="string"
                        Property="user => user.DepartmentName.Truncate(40)" Title="Avdeling"/>
        <PropertyColumn T="UserDto" TProperty="string"
                        Property="user => user.ManagerName.Truncate(40)" Title="Nærmeste leder"/>
    </Columns>
</ListPage>

@code {
    // ===================== PARAMETER =====================
    [SupplyParameterFromQuery(Name = "deleted")] // Ved sletting av en bruker
    public bool Deleted { get; set; }
    
    // ===================== PRIVATE FELT =====================
    private List<UserDto> _users = [];
    private HashSet<UserDto> _selectedUsers = [];
    
    private bool _isLoading = true;
    private AlertInfo? _alert;
    
    // ===================== LIFECYCLE =====================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var getUsersResult = await UserService.GetAllAsync(Cts.Token);

            if (getUsersResult.IsFailure)
            {
                _alert = new AlertInfo(getUsersResult.Error!.ToString(), Severity.Error);
                return;
            }

            _users = getUsersResult.Value!;
            
            if (Deleted)
                _alert = new AlertInfo("Brukeren er slettet", Severity.Info);
        }
        catch (OperationCanceledException)
        {
            // Brukeren navigerte bort, fang opp stille
        }
        catch
        {
            _alert = new AlertInfo("Klarte ikke å laste brukere. Oppdater siden for å prøve igjen",
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    // ===================== PRIVATE METHODS =====================
    
    private void OnUserClick(DataGridRowClickEventArgs<UserDto> args) =>
        NavigationManager.NavigateTo(PageRoutes.Users.Detail(args.Item.Id));
    
}