@inject IDocumentService DocumentService
@inject NavigationManager NavigationManager
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase

@* Widget som viser dokumenter innlogget bruker ikke har signert ennå, med lenke til detaljside *@

<MudPaper Class="pa-3" Style="@($"border-top: 3px solid {(_documents.Any() ? "#c62828" : "#2d7a4f")};")" 
          Elevation="4">
    <WidgetHeader Title="@DashboardConstants.PendingSignatures"
                  OnHide="OnHide"
                  Icon="@Icons.Material.Filled.Draw"
                  AccentColor="@(_hasPending == true ? "#c62828"
                               : _hasPending == false ? "#2d7a4f" : "#9e9e9e")"
                  IconBackgroundColor="@(_hasPending == true ? "#fdecea"
                                       : _hasPending == false ? "#e8f5ee" : "#f5f5f5")"/>

    <AppAlert @bind-Alert="_alert"/>

    @if (_loading)
    {
        <AppSpinner/>
    }
    else if (!_documents.Any())
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small"/>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ingen ventende signeringer.</MudText>
        </MudStack>
    }
    else
    {

        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1" Class="mt-1">
            <MudText Typo="Typo.h4" Color="Color.Warning">@_documents.Count</MudText>
            <MudText Typo="Typo.body2" Color="Color.Warning">
                dokument@(_documents.Count == 1 ? "" : "er") venter signering
            </MudText>
        </MudStack>
        <MudList T="DocumentListDto" Dense="true" DisablePadding="true">
            @foreach (var doc in _documents)
            {
                <MudListItem T="DocumentListDto"
                             Dense="true"
                             Class="px-0"
                             OnClick="() => NavigationManager.NavigateTo(
                                 PageRoutes.UserDocuments.Detail(doc.Slug, doc.Id))">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Color="Color.Error">@doc.Title.Truncate(40)</MudText>
                            @if (!string.IsNullOrWhiteSpace(doc.CategoryName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@doc.CategoryName</MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Error">v@(doc.Version)</MudText>
                        </MudStack>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                 Color="Color.Warning" Size="Size.Small"/>
                    </MudStack>
                </MudListItem>
                <MudDivider/>
            }
        </MudList>
        <MudLink Href="@PageRoutes.UserDocuments.Overview" Typo="Typo.caption" Class="mt-2 d-block">
            Se alle mine dokumenter →
        </MudLink>
    }
</MudPaper>

@code {
    // ======================== PARAMETERS ========================
    /// <summary>
    /// Handling som utføres ved trykk på 'Skjul'-knappen
    /// </summary>
    [Parameter] public EventCallback OnHide { get; set; }

    // ======================== PRIVATE FIELDS ========================

    private AlertInfo? _alert;
    private bool _loading = true;
    private List<DocumentListDto> _documents = [];
    private bool? _hasPending;

    // ======================== PRIVATE METHODS ========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var query = new DocumentQueryParameters
            {
                SignatureFilter = DocumentSignatureFilter.Pending,
                PageSize = 5,
                Page = 1
            };

            var result = await DocumentService.GetUserDocumentsAsync(query, Cts.Token);
            if (result.IsFailure)
            {
                _alert = new AlertInfo(result.Error!.ToString(), Severity.Error);
                return;
            }

            _documents = result.Value!.Items.ToList();
            _hasPending = _documents.Any();
        }
        finally
        {
            _loading = false;
        }
    }

}