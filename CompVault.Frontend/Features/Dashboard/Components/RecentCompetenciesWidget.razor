@inject ICompetencyService CompetencyService
@inject CircuitUserContext UserContext
@inject NavigationManager NavigationManager
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase

@* Widget som viser de 5 siste kompetansene til innlogget bruker *@

<MudPaper Class="pa-3" Style="border-top: 3px solid #2d7a4f;" Elevation="4">
    <WidgetHeader Title="@DashboardConstants.RecentCompetencies"
                  OnHide="OnHide"
                  Icon="@Icons.Material.Filled.WorkspacePremium"
                  AccentColor="#2d7a4f"
                  IconBackgroundColor="#e8f5ee"/>

    <AppAlert @bind-Alert="_alert"/>

    @if (_loading)
    {
        <AppSpinner/>
    }
    else if (!_competencies.Any())
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Secondary" Size="Size.Small"/>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ingen kompetanser registrert.</MudText>
        </MudStack>
    }
    else
    {
        <MudList T="CompetencyDto" Dense="true" DisablePadding="true" Class="mt-1">
            @foreach (var item in _competencies)
            {
                <MudListItem T="CompetencyDto"
                             Dense="true"
                             Class="px-0"
                             OnClick="() => NavigationManager.NavigateTo(
                             PageRoutes.UserCompetencies.Detail(item.Id))">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">@item.CompetencyTypeName.Truncate(30)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @if (item.ExpiryDate is null)
                                {
                                    <span>Ingen utløpsdato</span>
                                }
                                else
                                {
                                    <span>@item.DaysUntilExpiry.ToExpiryText(item.Status)</span>
                                }
                            </MudText>
                        </MudStack>
                        <MudChip T="string"
                                 Color="@item.Status.ToStatusColor()"
                                 Size="Size.Small"
                                 Class="cv-rounded">
                            @item.Status.ToDisplayString()
                        </MudChip>
                    </MudStack>
                </MudListItem>
                <MudDivider/>
            }
        </MudList>
        <MudLink Href="@PageRoutes.UserCompetencies.List" Typo="Typo.caption" Class="mt-2 d-block">
            Se alle mine kompetanser →
        </MudLink>
    }
</MudPaper>

@code {
    // ======================== PARAMETERS ========================
    
    /// <summary>
    /// Handling som utføres ved trykk på 'Skjul'-knappen
    /// </summary>
    [Parameter] public EventCallback OnHide { get; set; }

    // ======================== PRIVATE FIELDS ========================

    private AlertInfo? _alert;
    private bool _loading = true;
    private List<CompetencyDto> _competencies = [];

    // ======================== PRIVATE METHODS ========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var filter = new CompetencyFilterRequest
            {
                UserId   = UserContext.UserId,
                PageSize = 5,
                Page     = 1
            };

            var result = await CompetencyService.GetAllAsync(filter, Cts.Token);
            if (result.IsFailure)
            {
                _alert = new AlertInfo(result.Error!.ToString(), Severity.Error);
                return;
            }

            _competencies = result.Value!.Items.ToList();
        }
        finally
        {
            _loading = false;
        }
    }
}