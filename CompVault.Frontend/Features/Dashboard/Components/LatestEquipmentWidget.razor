@inject IEquipmentIssuancesService EquipmentIssuancesService
@inherits CompVault.Frontend.Common.Base.DisposableComponentBase

@* Viser de siste utleveringene til innlogget bruker - 3 stk*@

<MudPaper Class="pa-3" Style="border-top: 3px solid #6a1b9a;" Elevation="4">
    <WidgetHeader Title="@DashboardConstants.LatestEquipment"
                  OnHide="OnHide"
                  Icon="@Icons.Material.Filled.History"
                  AccentColor="#6a1b9a"
                  IconBackgroundColor="#f3e5f5"/>

    <AppAlert @bind-Alert="_alert"/>
    
    @if (_loading)
    {
        <AppSpinner/>
    }
    else if (!_items.Any())
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
            <MudIcon Icon="@Icons.Material.Filled.Headset" Color="Color.Secondary" Size="Size.Small"/>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ingen utleveringer registrert.</MudText>
        </MudStack>
    }
    else
    {
        <MudList T="EquipmentIssuanceDto" Dense="true" Class="pa-0 mt-1">
            @foreach (var item in _items)
            {
                <MudListItem T="EquipmentIssuanceDto" Class="px-0">
                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">
                        
                        <MudIcon Icon="@Icons.Material.Filled.Checkroom"
                                 Color="Color.Primary"
                                 Size="Size.Small"/>
                        
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">@item.ItemName.Truncate(35)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @item.IssuedDate.ToString("dd.MM.yyyy")
                                @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                {
                                    <span> - @item.CategoryName</span>
                                }
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudListItem>
                <MudDivider/>
            }
        </MudList>
        <MudLink Href="@PageRoutes.UserEquipment.Overview" Typo="Typo.caption" Class="mt-2 d-block">
            Se alt utstyr →
        </MudLink>
    }
</MudPaper>

@code {
    // ======================== PARAMETERS ======================== 
    
    /// <summary>
    /// Handling som utføres ved trykk på 'Skjul'-knappen
    /// </summary>
    [Parameter] public EventCallback OnHide { get; set; }
    
    // ======================== PRIVATE FIELD ======================== 
    
    private List<EquipmentIssuanceDto> _items = [];
    private AlertInfo? _alert;
    private bool _loading = true;
    
    // ======================== PRIVATE METHODS ======================== 
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var query = new PagedQuery { Page = 1, PageSize = 3 };
            var result = await EquipmentIssuancesService.GetMyEquipmentAsync(null, query, Cts.Token);
            if (result.IsFailure)
            {
                _alert = new AlertInfo(result.Error!.ToString(), Severity.Error);
                return;
            }

            _items = result.Value!.Items.ToList();
        }
        finally
        {
            _loading = false;
        }
    }
}