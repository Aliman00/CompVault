flowchart TB
    subgraph NOTE1["Om utstyrs-tilgangskontroll"]
    direction TB
        note1["EquipmentIssuance har ikke direkte DepartmentId — koblet til avdeling indirekte via UserId → ApplicationUser.DepartmentId. ApplyDepartmentFilter gjør en subquery mot AspNetUsers med IgnoreQueryFilters og manuell DeletedAt-sjekk for å finne tillatte bruker-IDer. Scope-sjekk ved opprettelse skjer i EquipmentIssuanceService via departmentScope.IsAllowed med equipment-permissions, ikke user-permissions."]:::note
    end

    subgraph PERMISSIONS["Lag 1 — Permissions på kontrolleren"]
        P1(["Request ankommer"])
        P2{"Authorize-policy: equipment:read / write / delete"}
        P3(["403 Forbidden — mangler permission"])
        P4["Requesten når kontrolleren"]
    end

    subgraph READ["Lag 2 — Leseoperasjoner — EquipmentIssuanceRepository.ApplyDepartmentFilter"]
        R1["Repository mottar spørring — QueryWithDetails / GetByIdWithDetailsAsync / GetForUpdateAsync"]
        R2{"HasBypass — bruker har equipment:read:all?"}
        R3["Ingen avdelingsfiltrering"]
        R4{"Har bruker equipment:read:sub?"}
        R5["DepartmentScopeService.GetAllowedDepartmentIds — BFS nedover — Lazy, én gang per request"]
        R6["Subquery mot AspNetUsers med IgnoreQueryFilters — finner User-IDer der DepartmentId = ANY tillatteAvdelinger og DeletedAt IS NULL"]
        R7["WHERE IssuanceUserId = ANY tillatteUserIder"]
        R8["Kun mottakere i brukerens egen avdeling"]
        R9(["Filtrerte utleveringer returneres"])
        R10["Bruker-spesifikke operasjoner — GetByUserIdPagedAsync og GetCategoriesForUserAsync — filtreres ikke ytterligere"]
    end

    subgraph WRITE["Lag 2 — Opprettelse — EquipmentIssuanceService.CreateAsync"]
        C1(["POST — opprett utlevering"])
        C2["Henter mottaker-bruker med GetByIdIgnoringFiltersAsync — skiller 404 fra 403"]
        C3{"Bruker finnes?"}
        C4(["404 Not Found"])
        C5{"departmentScope.IsAllowed — mottakerens DepartmentId, EquipmentAll / EquipmentReadSub"}
        C6(["403 Forbidden — mottaker utenfor scope"])
        C7["Validering OK — oppretter utlevering"]
        C8(["201 Created"])
    end

    subgraph UPDATE_DELETE["Lag 2 — Oppdatering og sletting — via GetForUpdateAsync"]
        U1(["PUT / DELETE — oppdater eller slett utlevering"])
        U2["Service kaller GetForUpdateAsync — bruker ApplyDepartmentFilter internt"]
        U3{"Utlevering funnet innenfor scope?"}
        U4(["404 Not Found — finnes ikke eller utenfor scope"])
        U5["Utfører oppdatering / soft-delete"]
        U6(["200 OK / 204 No Content"])
    end

