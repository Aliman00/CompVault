flowchart TB
    subgraph NOTE1["Om dokument-tilgangskontroll"]
    direction TB
        note1["Dokumenter er ikke eid av en avdeling — de er publisert til avdelinger og stillingstitler via mange-til-mange-tabeller. DocumentRepository.ApplyTargetingFilter filtrerer på hvilke avdelinger og stillingstitler dokumentet er rettet mot. Dette er publiseringslogikk, ikke scope-logikk. EF Core støtter ikke collection-navigasjoner i global query filters uten rekursivt kaos, så filteret håndteres manuelt i repository-laget."]:::note
    end

    subgraph PERMISSIONS["Lag 1 — Permissions på kontrolleren"]
        P1(["Request ankommer"])
        P2{"Authorize-policy: documents:read / write / delete"}
        P3(["403 Forbidden — mangler permission"])
        P4["Requesten når kontrolleren"]
    end

    subgraph READ["Lag 2 — Leseoperasjoner — DocumentRepository.ApplyTargetingFilter"]
        R1["Repository mottar spørring"]
        R2["Leser brukerens avdelings-ID og stillingstittel fra context"]
        R3{"Er dokumentet rettet mot brukerens avdeling — DocumentDepartments?"}
        R4{"Er dokumentet rettet mot brukerens stillingstittel — DocumentJobTitles?"}
        R5["Dokumentet inkluderes i resultatet"]
        R6["Dokumentet filtreres bort"]
        R7(["Relevante dokumenter returneres"])
        R8["Uploader-navigasjon bruker IsRequired false — LEFT JOIN — dokumenter forsvinner ikke selv om opplasteren er i annen avdeling"]
    end

    subgraph WRITE["Lag 2 — Opprettelse og oppdatering — DocumentService"]
        C1(["POST / PUT — opprett eller oppdater dokument"])
        C2["DocumentService validerer at publiseringsmål er gyldige — avdelinger og stillingstitler finnes"]
        C3{"Validering OK?"}
        C4(["400 Bad Request eller 404 Not Found"])
        C5["Oppretter / oppdaterer dokument med DocumentDepartments og DocumentJobTitles"]
        C6(["201 Created / 200 OK"])
    end

    subgraph DELETE["Lag 2 — Sletting — DocumentService"]
        D1(["DELETE — slett dokument"])
        D2["Henter dokument med GetByIdAsync"]
        D3{"Dokumentet finnes?"}
        D4(["404 Not Found"])
        D5["Soft-delete — DeletedAt settes"]
        D6(["204 No Content"])
    end

    subgraph SPECIAL["Merknader"]
        S1["Uploader-navigasjon — IsRequired false gir LEFT JOIN i stedet for INNER JOIN. Dokumentet forsvinner ikke selv om opplasteren er i en avdeling utenfor scope."]
        S2["Dokumenter scopet ikke på avdelingsmedlemskap. Synlighet styres utelukkende av hvilke avdelinger og stillingstitler dokumentet er publisert til."]
    end

    P1 --> P2
    P2 -- "Mangler permission" --> P3
    P2 -- "Har permission" --> P4
    P4 -- "GET" --> R1
    P4 -- "POST / PUT" --> C1
    P4 -- "DELETE" --> D1

