flowchart TB
    subgraph NOTE1["Om avdelingsscope — interceptor og query filter"]
    direction TB
        note1["Viser hvordan DepartmentScopeService bygger opp tillatte avdelinger per request, og hvordan DepartmentScopeSaveChangesInterceptor beskytter skriveoperasjoner på ApplicationUser. Det globale query filteret på AppDbContext kjøres automatisk på alle leseoperasjoner mot brukertabellen — ingen repository eller service trenger å huske på det."]:::note
    end

    subgraph READ[" "]
        R1(["GET-request ankommer med JWT-cookie"])
        R2{"Permission-sjekk på kontroller — users:read"}
        R3(["403 Forbidden — mangler permission"])
        R4["AppDbContext evaluerer global query filter på ApplicationUser automatisk"]
        R5{"HasBypass — bruker har users:read:all?"}
        R6["Ingen avdelingsfiltrering"]
        R7{"Har bruker users:read:sub?"}
        R8["DepartmentScopeService leser department_id fra JWT-claim"]
        R9["BFS nedover i avdelingshierarkiet fra brukerens avdeling"]
        R10["DepartmentRepository.GetAllWithHierarchyAsync — IgnoreQueryFilters, BFS trenger alle avdelinger"]
        R11["Resultat caches i Lazy per request"]
        R12["SQL: WHERE DepartmentId = ANY tillatteAvdelinger AND DeletedAt IS NULL"]
        R13["Kun brukerens egen avdeling i tillatt-listen"]
        R14(["Filtrerte brukere returneres"])
    end

    subgraph WRITE[" "]
        W1(["POST / PUT / DELETE-request"])
        W2{"Permission-sjekk på kontroller — users:write / users:delete"}
        W3(["403 Forbidden — mangler permission"])
        W4["Kontroller kaller service → repository → SaveChangesAsync"]
        W5["DepartmentScopeSaveChangesInterceptor — SavingChangesAsync kjøres"]
        W6{"Finnes autentisert bruker i HttpContext — ingen ved seeding / migrasjoner?"}
        W7["Hopper over validering — lagrer direkte"]
        W8{"IsAllowed — targetDepartmentId, UsersAll, UsersReadSub"}
        W9(["UnauthorizedAccessException → 403"])
        W10(["Lagret — 200 OK / 201 Created"])
    end

    subgraph AUTH[" "]
        A1["GetByEmailAsync — GetByIdIgnoringFiltersAsync — OtpCodeRepository.GetActiveCodeAsync — RefreshTokenRepository.GetValidTokenAsync"]
        A2["Disse bruker alltid IgnoreQueryFilters. Brukeren er ikke logget inn ennå og har ingen department_id å filtrere på."]
    end

