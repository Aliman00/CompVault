        <mxCell id="aUCQ8jEHUf2heckm5pg0-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Status-koder som ikke er 401&lt;/div&gt;" vertex="1">
