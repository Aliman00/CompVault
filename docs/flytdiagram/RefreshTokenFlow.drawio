        </mxCell>
        <mxCell id="aUCQ8jEHUf2heckm5pg0-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="Kloner requesten" vertex="1">
