        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-14" parent="WIyWlLk6GJQsqaUBKTNV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt;Backend returnerer 401&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="120" x="510" y="545" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-36" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="eNfZHel5HIWmgv-oSqI_-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="eNfZHel5HIWmgv-oSqI_-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-43" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="eNfZHel5HIWmgv-oSqI_-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="eNfZHel5HIWmgv-oSqI_-41">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-18" parent="WIyWlLk6GJQsqaUBKTNV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;ErrorCode = InvalidToken&lt;/div&gt;&lt;div&gt;Kan være Race Condition som skjer da 2 forespørsler kjører samtidig. Bruker fortsatt autorisert, men kall gir 401&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="140" x="422" y="740" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-22" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Oppdaterer auth-cookie, refrehs token-cookie og HttpContext med nye tokens - bruker er fortsatt autorisert" vertex="1">
          <mxGeometry height="80" width="150" x="150" y="545" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-33" parent="WIyWlLk6GJQsqaUBKTNV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt;ErrorCode = AccountInactive&lt;/div&gt;&lt;div&gt;Bruker har blitt deaktivtert eller token revoked. Logges ut i UI-en og cookies slettes&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="120" x="590" y="740" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-39" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="eNfZHel5HIWmgv-oSqI_-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="eNfZHel5HIWmgv-oSqI_-38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-35" parent="WIyWlLk6GJQsqaUBKTNV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt;Ingen forespørsler har bekreftet bruker autorisert:&lt;/div&gt;&lt;div&gt;Vis feilmelding i UI-en&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="170" x="407" y="890" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-45" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="494" y="1150" />
              <mxPoint x="762" y="1150" />
            </Array>
            <mxPoint x="494" y="1120" as="sourcePoint" />
            <mxPoint x="480" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-38" parent="WIyWlLk6GJQsqaUBKTNV-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt;Bruker kan kalle backend, men vil kun få 401 i 10 minutter til CookieValidation kjøres igjen.&lt;/div&gt;&lt;div&gt;AccessTokenHandler vil prøve å refreshe tokene på hvert kall, men det vil også feile&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="170" x="407" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-41" parent="WIyWlLk6GJQsqaUBKTNV-1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Hvis en av forespørselene refreshet tokens - bruker er fortsatt autorisert" vertex="1">
          <mxGeometry height="80" width="150" x="201.5" y="755" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-47" parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Etter 10 min så kan CookieValidaitonEvent kjøre på nytt,&lt;/div&gt;&lt;div&gt;ved f.eks oppdatering eller navigering&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="150" x="590" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-48" parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;CookieValidationEvents - kjøres når brukeren åpner siden for første gang, bruker oppdaterer siden (F5), bruker navigerer til ny url på vårt domene i adressefeltet eller krets brytes og gjennopprettes.&lt;/div&gt;&lt;div&gt;Den blir kjørt av UseAuthentication()-middlware på hver HTTP-request til server-side. Vi har en setting kalt ValidateIntervalMinutes som sikrer at vi ikke kjører RefreshToken på hver request&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="366" x="231" y="40" as="geometry" />
        </mxCell>
        <mxCell id="eNfZHel5HIWmgv-oSqI_-49" parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Merk: 10 minutter er brukt som et eksempel her. AuthSettings sin ValidateIntervalMinutes styrer hvor ofte CookieValidationEvent kjører. Skal være noen minutter mindre enn utløpstiden på en RefreshToken i backend&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="30" y="120" as="geometry" />
        </mxCell>
        <UserObject label="https://jakeydocs.readthedocs.io/en/latest/security/authentication/cookie.html" link="https://jakeydocs.readthedocs.io/en/latest/security/authentication/cookie.html" id="DPc4_qDfrSUQ0kfVxJZv-0">
          <mxCell parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="40" width="223.5" x="56.5" y="1050" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="DPc4_qDfrSUQ0kfVxJZv-1" parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Dokumentasjon:" vertex="1">
          <mxGeometry height="30" width="90" x="53.25" y="960" as="geometry" />
        </mxCell>
        <UserObject label="https://github.com/dotnet/AspNetCore.Docs/blob/main/aspnetcore/security/authentication/cookie.md" link="https://github.com/dotnet/AspNetCore.Docs/blob/main/aspnetcore/security/authentication/cookie.md" id="DPc4_qDfrSUQ0kfVxJZv-2">
          <mxCell parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;whiteSpace=wrap;" vertex="1">
