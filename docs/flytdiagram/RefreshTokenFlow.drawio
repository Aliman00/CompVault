          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aUCQ8jEHUf2heckm5pg0-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="Sender den originale requesten" vertex="1">
          <mxGeometry height="40" width="94" x="367" y="450" as="geometry" />
