  </diagram>
  <diagram id="_8Frjms3wEEJPwytoCMQ" name="AccessTokenHandler">
    <mxGraphModel dx="1425" dy="1248" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="aUCQ8jEHUf2heckm5pg0-1" edge="1" parent="1" source="aUCQ8jEHUf2heckm5pg0-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="414" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="aUCQ8jEHUf2heckm5pg0-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Bruker utfører handling som sender API-kall til backend" vertex="1">
          <mxGeometry height="70" width="120" x="354" y="190" as="geometry" />
        </mxCell>
        <mxCell id="aUCQ8jEHUf2heckm5pg0-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;AccessTokenHandler er en delegating handler så kjøres på utgåeende HTTP-kall fra hoved http-klienten vår.&lt;/div&gt;&lt;div&gt;Den kloner en request (da de er single-use) før den sendes, og sender requesten og ser om den failer. Hvis requesten failer med statuskode 401, så prøver vi å refreshe tokenparet. Hvis tokene blir refreshet, så sender vi den klonete forespørselen på nytt denne gangen med riktig access token.&lt;/div&gt;&lt;div&gt;Failer refreshingen så sendes responsen videre til Blazor-komponenten som kalte den.&lt;/div&gt;&lt;div&gt;Denne brukes i hovedsak hvis en bruker sitter lenge stille på en side, Access token utløper og ingen CookieValidationEvents blir trigget (av navigering/refresh)&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="331" x="249" y="20" as="geometry" />
        </mxCell>
        <mxCell id="aUCQ8jEHUf2heckm5pg0-18" edge="1" parent="1" source="aUCQ8jEHUf2heckm5pg0-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="aUCQ8jEHUf2heckm5pg0-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aUCQ8jEHUf2heckm5pg0-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="AccessTokenHandler starter (Scoped livstid)" vertex="1">
          <mxGeometry height="70" width="156" x="336" y="290" as="geometry" />
        </mxCell>
        <mxCell id="aUCQ8jEHUf2heckm5pg0-20" edge="1" parent="1" source="aUCQ8jEHUf2heckm5pg0-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="aUCQ8jEHUf2heckm5pg0-19">
