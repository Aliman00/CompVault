flowchart TB
    subgraph NOTE1["Om CircuitUserContext-flyten"]
    direction TB
        note1["Viser hvordan brukerkontekst flyter fra HTTP-request gjennom SSR, til SignalR-krets og til autorisasjon i komponenter. App.razor og CircuitUserContextHandler sørger for at CircuitUserContext alltid har riktig bruker og refresh token tilgjengelig inne i kretsen der HttpContext er null."]
    end
    subgraph SSR["Fase 1 — HTTP/SSR"]
        B["Browser sender GET-request til server"]
        C["CookieValidationEvents kjøres — oppdaterer CircuitUserContext.RefreshToken ved vellykket refresh"]
        D["App.razor OnInitialized kjøres under SSR-fasen"]
        E(["Redirect til /login"])
        F{"HttpContext autentisert og refresh token-cookie finnes?"}
        G["CircuitUserContext.SetUser kalt — bruker CircuitUserContext.RefreshToken hvis allerede satt av CookieValidationEvents, ellers request-cookie"]
        H["CircuitUserContext forblir tom"]
        I["HTML-shell sendes til browser"]
    end
    subgraph CIRCUIT["Fase 2 — SignalR-krets etableres"]
        J["Browser laster assets og starter Blazor"]
        K["WebSocket-tilkobling opprettes. CircuitUserContextHandler.OnConnectionUpAsync kjøres"]
        L{"HttpContext tilgjengelig og bruker autentisert?"}
        M["CircuitUserContext forblir som satt av App.razor"]
        N{"Finnes refresh token i HttpContext-cookie eller CircuitUserContext?"}
        O["CircuitUserContext.SetUser kalt på nytt med oppdatert User og RefreshToken"]
        P["Kretsen er klar"]
    end
    subgraph AUTH["Fase 3 — Autorisasjon i komponenter"]
        Q["AuthStateProvider.GetAuthenticationStateAsync leser CircuitUserContext.User"]
        R{"Bruker autentisert?"}
        S(["Beskyttet side vises"])
        T(["Redirect til /login"])
    end
