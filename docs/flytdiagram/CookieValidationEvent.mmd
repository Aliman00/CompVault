flowchart TB
    A(["Bruker refresher en side eller navigerer til en side"]) --> B["CookieValidationEvent kjører på hver HTTP-request"]
    B --> C{"LastValidated i auth-cookie: har det gått mer enn 10 min?"}
    C -- Mindre enn 10 min --> D(["Brukeren har gyldige tokens og er autorisert"])
    C -- Mer enn 10 min --> E{"Har bruker en sub-claim med UserId?"}
    E -- Nei --> F["Brukeren er ikke autorisert: RejectPrincipal og SignOut fra HttpContext"]
    E -- Ja --> G{"PendingRefreshes: finnes det allerede en pågående refresh-task for denne brukeren?"}
    G -- "Nei: oppretter ny AsyncLazy-task og legger inn i PendingRefreshes" --> R{"Finnes refresh token-cookie?"}
    G -- "Ja: venter på eksisterende AsyncLazy-task" --> H["POST til RefreshToken i backend"]
    R -- Nei --> F
    R -- Ja --> H
    H -- Suksess --> I["Oppdaterer auth-cookie med access token-claim, setter ny refresh token-cookie, oppdaterer LastRefreshed og LastValidated"]
    I --> J["Begge parallelle requests leser LastRefreshed og setter LastValidated på egen context"]
    J --> K["Requestene rydder opp etter seg selv ved å fjerne seg fra PendingRefreshes"]
    K --> D
    H -- Feil --> L{"ErrorCode?"}
    L -- AccountInactive: Bruker er deaktivert --> M["RejectPrincipal, SignOut fra HttpContext og slett refresh token-cookie"]
    L -- "Annen feil f.eks. ugyldig token eller backend nede" --> N(["Feiler åpent: Bruker forblir autorisert. AccessTokenHandler håndterer 401 på neste kall til backend"])

