# Database
Database__Host=postgres
Database__Port=5432
Database__Name=compvault_db
Database__Username=compvault_user
Database__Password=compvault_dev_pass

# JWT innstillinger - MÅ være minst 32 tegn
JwtSettings__Secret=YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JwtSettings__Issuer=CompVault
JwtSettings__Audience=CompVault.Clients

# E-post (Resend API nøkkel)
Email__ApiKey=RESEND_API_KEY_HERE
Email__FromAddress=donotreply@compvault.no
