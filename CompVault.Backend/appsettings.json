{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "",
    "Port": 5432,
    "Name": "",
    "Username": "",
    "Password": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Otp": {
    "MaxFailedAttempts": 3,
    "ExpirationMinutes": 10,
    "MinResponseTimeRequestOtpMs": 500,
    "MinResponseTimeVerifyOtpMs": 500
  },
  "Email": {
    "ApiKey": "",
    "FromAddress": ""
  }
}